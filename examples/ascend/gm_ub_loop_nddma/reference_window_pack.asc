#include <algorithm>
#include <cstdint>
#include <cstdio>
#include <cstdlib>
#include <vector>

#include "acl/acl.h"
#include "c_api/asc_simd.h"

#ifndef COPY_STORAGE
#define COPY_STORAGE fp8_e4m3fn_t
#endif
#ifndef PACK_SEQUENCE
#define PACK_SEQUENCE 128
#endif
#ifndef PACK_CHANNEL_BYTES
#define PACK_CHANNEL_BYTES 64
#endif
#ifndef PACK_TILE_HEADS
#define PACK_TILE_HEADS 8
#endif
#ifndef PACK_BLOCKS
#define PACK_BLOCKS 1
#endif
#ifndef NDDMA_STORAGE
#define NDDMA_STORAGE COPY_STORAGE
#endif
#ifndef NDDMA_SKIP_DCI
#define NDDMA_SKIP_DCI 0
#endif
#ifndef PACK_TOKEN_MAJOR
#define PACK_TOKEN_MAJOR 0
#endif
#ifndef PACK_COMPARE_WIDTHS
#define PACK_COMPARE_WIDTHS 0
#endif

using Storage = COPY_STORAGE;
using NddmaStorage = NDDMA_STORAGE;
constexpr uint32_t ND_BYTES = sizeof(NddmaStorage);
static_assert(ND_BYTES == 1 || ND_BYTES == 2 || ND_BYTES == 4);
static_assert(NDDMA_SKIP_DCI == 0 || NDDMA_SKIP_DCI == 1);
static_assert(PACK_TOKEN_MAJOR == 0 || PACK_TOKEN_MAJOR == 1);
static_assert(sizeof(Storage) == 1,
              "This example requires one-byte storage units");

constexpr uint32_t BATCH = 1;
constexpr uint32_t SEQUENCE = PACK_SEQUENCE;
constexpr uint32_t HEADS = 32;
constexpr uint32_t CHANNEL_BYTES = PACK_CHANNEL_BYTES;
constexpr uint32_t TILE_HEADS = PACK_TILE_HEADS;
constexpr uint32_t TILE_TOKENS = 8;
constexpr uint32_t BLOCKS = PACK_BLOCKS;
constexpr uint32_t WINDOWS = SEQUENCE / TILE_TOKENS;
constexpr uint32_t HEAD_GROUPS = HEADS / TILE_HEADS;
constexpr uint32_t TASKS = BATCH * WINDOWS * HEAD_GROUPS;
constexpr uint32_t TILE_BYTES = TILE_HEADS * TILE_TOKENS * CHANNEL_BYTES;
constexpr uint32_t TOTAL_BYTES = BATCH * SEQUENCE * HEADS * CHANNEL_BYTES;
static_assert(SEQUENCE % TILE_TOKENS == 0 && HEADS % TILE_HEADS == 0);
static_assert(CHANNEL_BYTES % 32 == 0 && TILE_BYTES <= 65536);
static_assert(TASKS % BLOCKS == 0);
static_assert(CHANNEL_BYTES % ND_BYTES == 0);
constexpr uint32_t ND_HEADS = PACK_TOKEN_MAJOR ? 1 : TILE_HEADS;
constexpr int MODE_COUNT = PACK_COMPARE_WIDTHS ? 6 : 3;

enum class ReadMode { Ordinary, Loop, Nddma };

template <ReadMode Mode, typename NDType = NddmaStorage,
          bool SkipDci = NDDMA_SKIP_DCI>
__aicore__ inline void PackWindows(__gm__ uint8_t *output,
                                   __gm__ uint8_t *input) {
  constexpr uint32_t ND_BYTES = sizeof(NDType);
  constexpr uint32_t ND_INNER =
      (PACK_TOKEN_MAJOR ? TILE_HEADS * CHANNEL_BYTES : CHANNEL_BYTES) / ND_BYTES;
  static_assert(CHANNEL_BYTES % ND_BYTES == 0);
  asc_init();
  __ubuf__ NDType local[TILE_BYTES / ND_BYTES];
  __ubuf__ uint8_t *bytes = reinterpret_cast<__ubuf__ uint8_t *>(local);
  if constexpr (Mode == ReadMode::Nddma) {
    asc_set_ndim_loop0_stride(1, 1);
    asc_set_ndim_loop1_stride(ND_INNER, HEADS * CHANNEL_BYTES / ND_BYTES);
    asc_set_ndim_loop2_stride(
        PACK_TOKEN_MAJOR ? 0 : TILE_TOKENS * CHANNEL_BYTES / ND_BYTES,
        PACK_TOKEN_MAJOR ? 0 : CHANNEL_BYTES / ND_BYTES);
    asc_set_ndim_loop3_stride(0, 0);
    asc_set_ndim_loop4_stride(0, 0);
    asc_ndim_pad_count_config pad{};
    asc_set_ndim_pad_count(pad);
    if constexpr (!SkipDci)
      asc_ndim_copy_dci();
  } else if constexpr (Mode == ReadMode::Loop) {
    asc_set_gm2ub_loop_size(PACK_TOKEN_MAJOR ? 1 : TILE_HEADS, 1);
    asc_set_gm2ub_loop1_stride(CHANNEL_BYTES, TILE_TOKENS * CHANNEL_BYTES);
    asc_set_gm2ub_loop2_stride(0, 0);
  } else {
    asc_set_gm2ub_loop_size(1, 1);
  }
  for (uint32_t task = static_cast<uint32_t>(block_idx); task < TASKS;
       task += BLOCKS) {
    uint32_t b = task / (WINDOWS * HEAD_GROUPS);
    uint32_t w = (task / HEAD_GROUPS) % WINDOWS;
    uint32_t group = task % HEAD_GROUPS;
    uint32_t base =
        ((b * SEQUENCE + w * TILE_TOKENS) * HEADS + group * TILE_HEADS) *
        CHANNEL_BYTES;
    if constexpr (PACK_TOKEN_MAJOR && Mode != ReadMode::Nddma) {
      asc_copy_gm2ub_align(
          bytes, input + base, TILE_TOKENS, TILE_HEADS * CHANNEL_BYTES, 0, 0,
          false, asc_load_l2_cache_mode::NORMAL_FIRST_VICTIM,
          HEADS * CHANNEL_BYTES, TILE_HEADS * CHANNEL_BYTES);
    } else if constexpr (Mode == ReadMode::Ordinary) {
      for (uint32_t h = 0; h < TILE_HEADS; ++h) {
        asc_copy_gm2ub_align(bytes + h * TILE_TOKENS * CHANNEL_BYTES,
                             input + base + h * CHANNEL_BYTES, TILE_TOKENS,
                             CHANNEL_BYTES, 0, 0, false,
                             asc_load_l2_cache_mode::NORMAL_FIRST_VICTIM,
                             HEADS * CHANNEL_BYTES, CHANNEL_BYTES);
      }
    } else if constexpr (Mode == ReadMode::Loop) {
      asc_copy_gm2ub_align(bytes, input + base, TILE_TOKENS, CHANNEL_BYTES, 0,
                           0, false,
                           asc_load_l2_cache_mode::NORMAL_FIRST_VICTIM,
                           HEADS * CHANNEL_BYTES, CHANNEL_BYTES);
    } else {
      asc_ndim_copy_gm2ub(local,
                          reinterpret_cast<__gm__ NDType *>(input + base),
                          ND_INNER, TILE_TOKENS, ND_HEADS, 1, 1, 0, 0,
                          false, asc_load_l2_cache_mode::NORMAL_FIRST_VICTIM);
    }
    asc_sync_notify(PIPE_MTE2, PIPE_MTE3, EVENT_ID0);
    asc_sync_wait(PIPE_MTE2, PIPE_MTE3, EVENT_ID0);
    asc_copy_ub2gm_align(output + task * TILE_BYTES, bytes, TILE_BYTES);
    asc_sync_notify(PIPE_MTE3, PIPE_MTE2, EVENT_ID0);
    asc_sync_wait(PIPE_MTE3, PIPE_MTE2, EVENT_ID0);
  }
  if constexpr (Mode == ReadMode::Loop) {
    asc_set_gm2ub_loop_size(1, 1);
  }
  asc_sync_pipe(PIPE_ALL);
}

__global__ __vector__ void PackOrdinary(__gm__ uint8_t *output,
                                        __gm__ uint8_t *input) {
  PackWindows<ReadMode::Ordinary>(output, input);
}

__global__ __vector__ void PackLoop(__gm__ uint8_t *output,
                                    __gm__ uint8_t *input) {
  PackWindows<ReadMode::Loop>(output, input);
}

__global__ __vector__ void PackNddma(__gm__ uint8_t *output,
                                     __gm__ uint8_t *input) {
  PackWindows<ReadMode::Nddma>(output, input);
}

#if PACK_COMPARE_WIDTHS
__global__ __vector__ void PackB16(__gm__ uint8_t *output,
                                  __gm__ uint8_t *input) {
  PackWindows<ReadMode::Nddma, uint16_t>(output, input);
}
__global__ __vector__ void PackB32(__gm__ uint8_t *output,
                                  __gm__ uint8_t *input) {
  PackWindows<ReadMode::Nddma, uint32_t>(output, input);
}
__global__ __vector__ void PackNoDci(__gm__ uint8_t *output,
                                    __gm__ uint8_t *input) {
  PackWindows<ReadMode::Nddma, NddmaStorage, true>(output, input);
}
#endif

void Launch(int mode, aclrtStream stream, uint8_t *output, uint8_t *input) {
  if (mode == 0)
    PackOrdinary<<<BLOCKS, 0, stream>>>(output, input);
  if (mode == 1)
    PackLoop<<<BLOCKS, 0, stream>>>(output, input);
  if (mode == 2)
    PackNddma<<<BLOCKS, 0, stream>>>(output, input);
#if PACK_COMPARE_WIDTHS
  if (mode == 3)
    PackB16<<<BLOCKS, 0, stream>>>(output, input);
  if (mode == 4)
    PackB32<<<BLOCKS, 0, stream>>>(output, input);
  if (mode == 5)
    PackNoDci<<<BLOCKS, 0, stream>>>(output, input);
#endif
}

int main(int argc, char **argv) {
  std::setvbuf(stdout, nullptr, _IOLBF, 0);
  const int rounds = argc > 1 ? std::atoi(argv[1]) : 0;
  if (rounds < 0 || rounds > 1000) {
    std::fprintf(stderr, "Expected 0..1000 measurement rounds, got %d\n",
                 rounds);
    return 1;
  }
  std::vector<uint8_t> input(TOTAL_BYTES), output(TOTAL_BYTES),
      golden(TOTAL_BYTES);
  uint32_t seed = 3308;
  for (uint32_t i = 0; i < TOTAL_BYTES; ++i) {
    seed = seed * 1664525u + 1013904223u;
    input[i] = static_cast<uint8_t>(seed >> 24);
  }
  for (uint32_t b = 0; b < BATCH; ++b) {
    for (uint32_t t = 0; t < SEQUENCE; ++t) {
      for (uint32_t h = 0; h < HEADS; ++h) {
        for (uint32_t d = 0; d < CHANNEL_BYTES; ++d) {
          uint32_t src = ((b * SEQUENCE + t) * HEADS + h) * CHANNEL_BYTES + d;
          uint32_t dst = (((((b * WINDOWS + t / TILE_TOKENS) * HEAD_GROUPS +
                             h / TILE_HEADS) *
                                TILE_HEADS +
                            h % TILE_HEADS) *
                               TILE_TOKENS +
                           t % TILE_TOKENS) *
                              CHANNEL_BYTES +
                          d);
          if constexpr (PACK_TOKEN_MAJOR) {
            dst = (((b * WINDOWS + t / TILE_TOKENS) * HEAD_GROUPS +
                    h / TILE_HEADS) * TILE_TOKENS * TILE_HEADS +
                   (t % TILE_TOKENS) * TILE_HEADS + h % TILE_HEADS) *
                      CHANNEL_BYTES + d;
          }
          golden[dst] = input[src];
        }
      }
    }
  }
  auto check = [](aclError error, const char *operation) {
    if (error != ACL_SUCCESS)
      std::fprintf(stderr, "%s failed: %d\n", operation,
                   static_cast<int>(error));
    return error == ACL_SUCCESS;
  };
  if (!check(aclInit(nullptr), "aclInit"))
    return 1;
  if (!check(aclrtSetDevice(0), "aclrtSetDevice")) {
    aclFinalize();
    return 1;
  }
  uint8_t *device_input = nullptr;
  uint8_t *device_output = nullptr;
  aclrtStream stream = nullptr;
  bool passed = check(aclrtMalloc(reinterpret_cast<void **>(&device_input),
                                  TOTAL_BYTES, ACL_MEM_MALLOC_HUGE_FIRST),
                      "allocate input");
  if (passed)
    passed = check(aclrtMalloc(reinterpret_cast<void **>(&device_output),
                               TOTAL_BYTES, ACL_MEM_MALLOC_HUGE_FIRST),
                   "allocate output");
  if (passed)
    passed = check(aclrtMemcpy(device_input, TOTAL_BYTES, input.data(),
                               TOTAL_BYTES, ACL_MEMCPY_HOST_TO_DEVICE),
                   "copy input");
  for (int mode = 0; passed && mode < MODE_COUNT; ++mode) {
    std::fill(output.begin(), output.end(), static_cast<uint8_t>(165));
    passed = check(aclrtMemcpy(device_output, TOTAL_BYTES, output.data(),
                               TOTAL_BYTES, ACL_MEMCPY_HOST_TO_DEVICE),
                   "poison output");
    if (!passed)
      break;
    Launch(mode, nullptr, device_output, device_input);
    passed = check(aclrtSynchronizeDevice(), "kernel execution");
    if (passed)
      passed = check(aclrtMemcpy(output.data(), TOTAL_BYTES, device_output,
                                 TOTAL_BYTES, ACL_MEMCPY_DEVICE_TO_HOST),
                     "read output");
    passed = passed && output == golden;
    const char *names[] = {"ordinary", "loop", "nddma", "b16", "b32", "no_dci"};
    const char *name = names[mode];
    std::printf("%s: %s; inbound requests/tile=%u; payload/tile=%u bytes\n",
                name, passed ? "PASS" : "FAIL", mode == 0 && !PACK_TOKEN_MAJOR ? TILE_HEADS : 1,
                TILE_BYTES);
  }
  if (passed && rounds > 0) {
    passed = check(aclrtCreateStream(&stream), "create benchmark stream");
    aclrtEvent start = nullptr, end = nullptr;
    if (passed)
      passed = check(aclrtCreateEvent(&start), "create start event");
    if (passed)
      passed = check(aclrtCreateEvent(&end), "create end event");
    for (int warmup = 0; passed && warmup < 10; ++warmup)
      for (int mode = 0; mode < MODE_COUNT; ++mode)
        Launch(mode, stream, device_output, device_input);
    if (passed)
      passed = check(aclrtSynchronizeStream(stream), "warmup");
    std::printf(
        "CONFIG,sequence=%u,heads=%u,channel_bytes=%u,tile_heads=%u,"
        "tile_tokens=%u,blocks=%u,payload_bytes=%u,warmup=10,rounds=%d,"
        "nddma_bytes=%u,skip_dci=%d,token_major=%d\n",
        SEQUENCE, HEADS, CHANNEL_BYTES, TILE_HEADS, TILE_TOKENS, BLOCKS,
        TOTAL_BYTES, rounds, ND_BYTES, NDDMA_SKIP_DCI, PACK_TOKEN_MAJOR);
    for (int round = 0; passed && round < rounds; ++round) {
      for (int slot = 0; passed && slot < MODE_COUNT; ++slot) {
        int mode = (round + slot) % MODE_COUNT;
        passed = check(aclrtRecordEvent(start, stream), "record start");
        if (!passed)
          break;
        Launch(mode, stream, device_output, device_input);
        passed = check(aclrtRecordEvent(end, stream), "record end");
        if (passed)
          passed = check(aclrtSynchronizeStream(stream), "benchmark execution");
        float ms = 0;
        if (passed)
          passed =
              check(aclrtEventElapsedTime(&ms, start, end), "elapsed time");
        if (passed)
          std::printf("SAMPLE,%d,%d,%.6f\n", round, mode, ms * 1000.0f);
      }
    }
    if (start)
      aclrtDestroyEvent(start);
    if (end)
      aclrtDestroyEvent(end);
    if (stream)
      aclrtDestroyStream(stream);
  }
  if (device_input)
    aclrtFree(device_input);
  if (device_output)
    aclrtFree(device_output);
  aclrtResetDevice(0);
  aclFinalize();
  return passed ? 0 : 1;
}
