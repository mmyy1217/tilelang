#include <algorithm>
#include <cstdint>
#include <cstdio>
#include <cstdlib>
#include <vector>
#include "acl/acl.h"
#include "c_api/asc_simd.h"
#include "kernel_operator.h"
#ifndef KV_REFERENCE_TYPES
#define KV_REFERENCE_TYPES
struct GatherPaKvCacheTilingDataV35 {
  uint64_t kvCacheBlockSize,batchPerCore,needCoreNum,batchCount,blockTableWidth;
  uint64_t maxUbHiddenSizeK,maxUbHiddenSizeV,maxUbHiddenSize,hiddenSizeK,hiddenSizeV;
  uint64_t numTokens,numBlocks,seqLenAccumSize,nonContiguousFlag;
  uint64_t kCacheStride0,vCacheStride0,keyOutStride0,valueOutStride0;
};
#define DTYPE_KEY uint8_t
#define DTYPE_VALUE uint8_t
#include "kv_reference_upstream.h"
#undef DTYPE_KEY
#undef DTYPE_VALUE
#endif
#ifndef TRANSPOSE
#define TRANSPOSE 0
#endif
#ifndef SOURCE_ROWS
#define SOURCE_ROWS 128
#endif
#ifndef SOURCE_COLS
#define SOURCE_COLS 1024
#endif
#ifndef TAKE_ROWS
#define TAKE_ROWS 8
#endif
#ifndef TAKE_COLS
#define TAKE_COLS 128
#endif
#ifndef TILE_GROUPS
#define TILE_GROUPS 16
#endif
#ifndef SOURCE_OFFSET
#define SOURCE_OFFSET 0
#endif
constexpr uint32_t B=SOURCE_ROWS, K=SOURCE_COLS, V=TAKE_COLS, P=TAKE_ROWS;
constexpr uint32_t BUF=98304, WIDTH=P+2;
constexpr int MODES=10;
static_assert(B>=1 && B<=256 && K>=32 && V>=32 && K%32==0 && V%32==0 && K<=BUF && V<=BUF);
static_assert(P>=1 && P<=32 && TILE_GROUPS>=1 && TILE_GROUPS<=256);
static_assert(SOURCE_OFFSET>=0 && SOURCE_OFFSET<3 && TRANSPOSE>=0 && TRANSPOSE<=1);

template<int M> __aicore__ inline void Load(__ubuf__ uint8_t *ub,__gm__ uint8_t *gm,uint32_t d,uint32_t count) {
  if constexpr(M==2 || M==4) {
    asc_set_gm2ub_loop_size(count,1);
    asc_set_gm2ub_loop1_stride(32,d);
    asc_copy_gm2ub_align(ub,gm,d/32,32,0,0,false,0,B*32,32);
    asc_set_gm2ub_loop_size(1,1);
  } else {
    asc_set_ndim_loop0_stride(1,1);
    asc_set_ndim_loop1_stride((M==8 || M==9) ? 32 : d,(M==8 || M==9) ? B*32 : 32);
    asc_set_ndim_loop2_stride((M==8 || M==9) ? d : 32,(M==8 || M==9) ? 32 : B*32);
    asc_set_ndim_loop3_stride(0,0); asc_set_ndim_loop4_stride(0,0);
    asc_ndim_copy_gm2ub(ub,gm,32,(M==8 || M==9) ? d/32 : count,(M==8 || M==9) ? count : d/32,1,1,0,0,false,asc_load_l2_cache_mode::NORMAL_FIRST_VICTIM);
  }
}

template<int M> __aicore__ inline void Page(__ubuf__ uint8_t *ub,__gm__ uint8_t *out,__gm__ uint8_t *src,uint32_t d,uint32_t valid) {
  if(!valid) return;
  if constexpr(M==0 || M==5 || M==6) {
    bool whole=M==5 ? B*d<=BUF : (B*K<=BUF && B*V<=BUF);
    if(whole) {
      Load<0>(ub,src,d,M==6 ? valid : B);
      asc_sync_notify(PIPE_MTE2,PIPE_MTE3,EVENT_ID0); asc_sync_wait(PIPE_MTE2,PIPE_MTE3,EVENT_ID0);
      asc_copy_ub2gm_align(out,ub,valid*d);
      asc_sync_notify(PIPE_MTE3,PIPE_MTE2,EVENT_ID0); asc_sync_wait(PIPE_MTE3,PIPE_MTE2,EVENT_ID0);
    } else {
      for(uint32_t t=0;t<valid;++t) {
        asc_copy_gm2ub_align(ub,src+t*32,d/32,32,0,0,false,0,B*32,32);
        asc_sync_notify(PIPE_MTE2,PIPE_MTE3,EVENT_ID0); asc_sync_wait(PIPE_MTE2,PIPE_MTE3,EVENT_ID0);
        asc_copy_ub2gm_align(out+t*d,ub,d);
        asc_sync_notify(PIPE_MTE3,PIPE_MTE2,EVENT_ID0); asc_sync_wait(PIPE_MTE3,PIPE_MTE2,EVENT_ID0);
      }
    }
  } else {
    uint32_t tile=BUF/d<TILE_GROUPS ? BUF/d : TILE_GROUPS;
    uint32_t tiles=(valid+tile-1)/tile;
    if constexpr(M==1 || M==2 || M==8) {
      for(uint32_t t=0;t<valid;t+=tile) {
        uint32_t n=valid-t<tile ? valid-t : tile;
        Load<M>(ub,src+t*32,d,n);
        asc_sync_notify(PIPE_MTE2,PIPE_MTE3,EVENT_ID0); asc_sync_wait(PIPE_MTE2,PIPE_MTE3,EVENT_ID0);
        asc_copy_ub2gm_align(out+t*d,ub,n*d);
        asc_sync_notify(PIPE_MTE3,PIPE_MTE2,EVENT_ID0); asc_sync_wait(PIPE_MTE3,PIPE_MTE2,EVENT_ID0);
      }
    } else {
      Load<M>(ub,src,d,valid<tile ? valid : tile);
      asc_sync_notify(PIPE_MTE2,PIPE_MTE3,EVENT_ID0);
      for(uint32_t i=0;i<tiles;++i) {
        uint32_t slot=i%2; event_t ev=slot ? EVENT_ID1 : EVENT_ID0;
        if(i+1<tiles) {
          uint32_t ns=(i+1)%2; event_t ne=ns ? EVENT_ID1 : EVENT_ID0;
          if(i+1>=2) asc_sync_wait(PIPE_MTE3,PIPE_MTE2,ne);
          uint32_t t=(i+1)*tile,n=valid-t<tile ? valid-t : tile;
          Load<M>(ub+ns*BUF,src+t*32,d,n); asc_sync_notify(PIPE_MTE2,PIPE_MTE3,ne);
        }
        asc_sync_wait(PIPE_MTE2,PIPE_MTE3,ev);
        uint32_t t=i*tile,n=valid-t<tile ? valid-t : tile;
        asc_copy_ub2gm_align(out+t*d,ub+slot*BUF,n*d);
        if(i+2<tiles) asc_sync_notify(PIPE_MTE3,PIPE_MTE2,ev);
      }
      asc_sync_notify(PIPE_MTE3,PIPE_MTE2,EVENT_ID2); asc_sync_wait(PIPE_MTE3,PIPE_MTE2,EVENT_ID2);
    }
  }
}

template<int M> __aicore__ inline void Run(__gm__ uint8_t *yk,__gm__ uint8_t *yv,__gm__ uint8_t *xk,__gm__ uint8_t *xv,
    __gm__ uint32_t *table,__gm__ uint32_t *lens,__gm__ uint32_t *offsets,uint32_t batches) {
  asc_init(); __ubuf__ uint8_t ub[2*BUF];
  asc_set_gm2ub_loop_size(1,1);
  asc_ndim_pad_count_config pad{}; asc_set_ndim_pad_count(pad); asc_ndim_copy_dci();
  uint32_t per=(batches+block_num-1)/block_num,start=block_idx*per,end=start+per;
  if(end>batches) end=batches;
  uint32_t outpos=0;
  if constexpr(TRANSPOSE) { if(start<batches) outpos=lens[start]; }
  else { for(uint32_t i=0;i<start && i<batches;++i) outpos+=lens[i]; }
  for(uint32_t r=start;r<end;++r) {
    uint32_t len=TRANSPOSE ? lens[r+1]-lens[r] : lens[r];
    uint32_t skip=offsets[r]/B, pages=(len+B-1)/B;
    for(uint32_t j=0;j<pages;++j) {
      uint32_t id=table[r*WIDTH+skip+j],n=len-j*B<B ? len-j*B : B;
      Page<M>(ub,yk+uint64_t(outpos+j*B)*K,xk+uint64_t(id)*B*K,K,n);
    }
    for(uint32_t j=0;j<pages;++j) {
      uint32_t id=table[r*WIDTH+skip+j],n=len-j*B<B ? len-j*B : B;
      Page<M>(ub,yv+uint64_t(outpos+j*B)*V,xv+uint64_t(id)*B*V,V,n);
    }
    outpos+=len;
  }
  asc_sync_pipe(PIPE_ALL);
}
#define KERNEL(Name,Mode) \
__global__ __vector__ void Name(__gm__ uint8_t *yk,__gm__ uint8_t *yv,__gm__ uint8_t *xk,__gm__ uint8_t *xv, \
    __gm__ uint32_t *table,__gm__ uint32_t *lens,__gm__ uint32_t *offsets,uint32_t batches) { Run<Mode>(yk,yv,xk,xv,table,lens,offsets,batches); }
KERNEL(KvOriginal,0)
KERNEL(KvNdSync,1)
KERNEL(KvLoopSync,2)
KERNEL(KvNdDouble,3)
KERNEL(KvLoopDouble,4)
KERNEL(KvIndependent,5)
KERNEL(KvTail,6)
KERNEL(KvNdOrderSync,8)
KERNEL(KvNdOrderDouble,9)
__global__ __vector__ void KvOfficial(__gm__ uint8_t *yk,__gm__ uint8_t *yv,__gm__ uint8_t *xk,__gm__ uint8_t *xv,
    __gm__ uint32_t *table,__gm__ uint32_t *lens,__gm__ uint32_t *offsets,uint32_t batches) {
  uint32_t per=(batches+block_num-1)/block_num,need=(batches+per-1)/per;
  if(block_idx>=need) return;
  GatherPaKvCacheTilingDataV35 tl{};
  tl.kvCacheBlockSize=B; tl.batchPerCore=per; tl.needCoreNum=need; tl.batchCount=batches;
  tl.blockTableWidth=WIDTH; tl.maxUbHiddenSizeK=B*K<BUF ? B*K : BUF;
  tl.maxUbHiddenSizeV=B*V<BUF ? B*V : BUF;
  tl.maxUbHiddenSize=tl.maxUbHiddenSizeK>tl.maxUbHiddenSizeV ? tl.maxUbHiddenSizeK : tl.maxUbHiddenSizeV;
  tl.hiddenSizeK=K; tl.hiddenSizeV=V; tl.numBlocks=batches*P+3; tl.seqLenAccumSize=1024;
  if constexpr(TRANSPOSE) tl.numTokens=lens[batches];
  else for(uint32_t r=0;r<batches;++r) tl.numTokens+=lens[r];
  AscendC::TPipe pipe;
  GatherPaKvCacheV35::GatherPaKvCacheNz<uint8_t,int32_t,(TRANSPOSE!=0),true> op(&pipe,&tl);
  op.Init(xk,xv,reinterpret_cast<__gm__ uint8_t *>(table),reinterpret_cast<__gm__ uint8_t *>(lens),yk,yv,
          reinterpret_cast<__gm__ uint8_t *>(offsets),yk,yv);
  op.Process();
}
void Check(aclError e,const char *name) { if(e!=ACL_SUCCESS) { std::fprintf(stderr,"ACL_FAILURE %s %d\n",name,int(e)); std::exit(2); } }
void Launch(int m,uint32_t blocks,aclrtStream stream,uint8_t *yk,uint8_t *yv,uint8_t *xk,uint8_t *xv,uint32_t *table,uint32_t *lens,uint32_t *offsets,uint32_t batches) {
#define CALL(M,Name) if(m==M) Name<<<blocks,0,stream>>>(yk,yv,xk,xv,table,lens,offsets,batches)
  CALL(0,KvOriginal); CALL(1,KvNdSync); CALL(2,KvLoopSync); CALL(3,KvNdDouble); CALL(4,KvLoopDouble); CALL(5,KvIndependent); CALL(6,KvTail); CALL(7,KvOfficial); CALL(8,KvNdOrderSync); CALL(9,KvNdOrderDouble);
#undef CALL
}
bool Verify(const std::vector<uint8_t>& got,const std::vector<uint8_t>& want) {
  for(size_t i=0;i<got.size();++i) if(got[i]!=want[i]) { std::fprintf(stderr,"MISMATCH offset=%zu got=%u expected=%u\n",i,got[i],want[i]); return false; }
  return true;
}
int Case(uint32_t groups,uint32_t blocks,int rounds,aclrtStream stream) {
  uint32_t physical=groups*P+3;
  if(!groups || groups>1024 || !blocks || blocks>64 || uint64_t(physical)*B*(K+V)>512*1024*1024) return 2;
  std::vector<uint8_t> hk(uint64_t(physical)*B*K),hv(uint64_t(physical)*B*V);
  std::vector<uint32_t> ht(groups*WIDTH),hl(groups+1),ho(groups),length(groups);
  uint8_t *xk,*xv,*yk,*yv; uint32_t *dt,*dl,*ds;
  uint64_t capk=uint64_t(groups)*P*B*K+128,capv=uint64_t(groups)*P*B*V+128;
#define ALLOC(PTR,SIZE) Check(aclrtMalloc((void**)&PTR,SIZE,ACL_MEM_MALLOC_HUGE_FIRST),#PTR)
  ALLOC(xk,hk.size()); ALLOC(xv,hv.size()); ALLOC(yk,capk); ALLOC(yv,capv);
  ALLOC(dt,ht.size()*4); ALLOC(dl,hl.size()*4); ALLOC(ds,ho.size()*4);
#undef ALLOC
  std::vector<uint8_t> gk(capk,0xa5),gv(capv,0xa5),ok(capk),ov(capv);
  auto upload=[](void *dst,const void *src,size_t n) { Check(aclrtMemcpy(dst,n,src,n,ACL_MEMCPY_HOST_TO_DEVICE),"upload"); };
  auto verify=[&]() { Check(aclrtMemcpy(ok.data(),capk,yk,capk,ACL_MEMCPY_DEVICE_TO_HOST),"download K"); Check(aclrtMemcpy(ov.data(),capv,yv,capv,ACL_MEMCPY_DEVICE_TO_HOST),"download V"); return Verify(ok,gk)&&Verify(ov,gv); };
  std::printf("CONFIG,batches=%u,blocks=%u,B=%u,Kbytes=%u,Vbytes=%u,pages=%u,tile=%u,cumsum=%d,tail=%d,ub_slot=%u\n",groups,blocks,B,K,V,P,TILE_GROUPS,TRANSPOSE,SOURCE_OFFSET,BUF);
  for(int pattern=0;pattern<3;++pattern) {
    uint32_t rng=12345+pattern;
    for(auto &v:hk) { rng=rng*1664525u+1013904223u; v=rng>>16; }
    for(auto &v:hv) { rng=rng*1664525u+1013904223u; v=rng>>16; }
    uint32_t total=0; hl[0]=0;
    std::fill(gk.begin(),gk.end(),0xa5); std::fill(gv.begin(),gv.end(),0xa5);
    for(uint32_t r=0;r<groups;++r) {
      uint32_t len=P*B-(SOURCE_OFFSET==1 ? B-1 : SOURCE_OFFSET==2 ? 1 : 0);
      if(pattern==1) len=r%4==0 ? 0 : r%4==1 ? 1 : r%4==2 ? B-1 : P*B-1;
      length[r]=len; ho[r]=(pattern==1 ? r%3 : 1)*B;
      if constexpr(TRANSPOSE) hl[r+1]=total+len; else hl[r]=len;
      for(uint32_t j=0;j<WIDTH;++j) ht[r*WIDTH+j]=(r*7+j*3+pattern)%physical;
      for(uint32_t t=0;t<len;++t) {
        uint32_t id=ht[r*WIDTH+ho[r]/B+t/B],slot=t%B;
        for(uint32_t d=0;d<K;++d) gk[64+uint64_t(total+t)*K+d]=hk[uint64_t(id)*B*K+uint64_t(d/32)*B*32+slot*32+d%32];
        for(uint32_t d=0;d<V;++d) gv[64+uint64_t(total+t)*V+d]=hv[uint64_t(id)*B*V+uint64_t(d/32)*B*32+slot*32+d%32];
      }
      total+=len;
    }
    upload(xk,hk.data(),hk.size()); upload(xv,hv.data(),hv.size());
    upload(dt,ht.data(),ht.size()*4); upload(dl,hl.data(),hl.size()*4); upload(ds,ho.data(),ho.size()*4);
    for(int m=0;m<MODES;++m) {
      std::fill(ok.begin(),ok.end(),0xa5); std::fill(ov.begin(),ov.end(),0xa5); upload(yk,ok.data(),capk); upload(yv,ov.data(),capv);
      Launch(m,blocks,stream,yk+64,yv+64,xk,xv,dt,dl,ds,groups); Check(aclrtSynchronizeStream(stream),"correctness");
      if(!verify()) return 3;
      std::printf("PASS,pattern=%d,mode=%d\n",pattern,m);
    }
  }
  if(rounds) {
    for(int w=0;w<20;++w) for(int m=0;m<MODES;++m) Launch(m,blocks,stream,yk+64,yv+64,xk,xv,dt,dl,ds,groups);
    Check(aclrtSynchronizeStream(stream),"warmup");
    for(int r=0;r<rounds;++r) for(int j=0;j<MODES;++j) {
      int m=(r+j)%MODES; Launch(m,blocks,stream,yk+64,yv+64,xk,xv,dt,dl,ds,groups); Check(aclrtSynchronizeStream(stream),"timed");
      if(r==rounds-1) { if(!verify()) return 3; std::printf("POST_CHECK,mode=%d,status=PASS\n",m); }
    }
  }
  aclrtFree(xk); aclrtFree(xv); aclrtFree(yk); aclrtFree(yv); aclrtFree(dt); aclrtFree(dl); aclrtFree(ds); return 0;
}
