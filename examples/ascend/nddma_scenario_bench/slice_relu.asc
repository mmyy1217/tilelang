#include <algorithm>
#include <cstdint>
#include <cstdio>
#include <cstdlib>
#include <cstring>
#include <vector>
#include "acl/acl.h"
#include "c_api/asc_simd.h"
#ifndef TRANSPOSE
#define TRANSPOSE 0
#endif
#ifndef SOURCE_OFFSET
#define SOURCE_OFFSET 1
#endif
#ifndef SOURCE_ROWS
#define SOURCE_ROWS 17
#endif
#ifndef SOURCE_COLS
#define SOURCE_COLS 65
#endif
#ifndef TAKE_ROWS
#define TAKE_ROWS 4
#endif
#ifndef TAKE_COLS
#define TAKE_COLS 16
#endif
#ifndef TILE_GROUPS
#define TILE_GROUPS 32
#endif
constexpr uint32_t H=SOURCE_ROWS, W=SOURCE_COLS, R=TAKE_ROWS, C=TAKE_COLS;
constexpr uint32_t O=R*C, S=H*W, SPAN=(R-1)*W+C, AP=(SPAN+7)/8*8;
constexpr int MODES=7;
static_assert(R>0 && (R&(R-1))==0 && C>=8 && (C&(C-1))==0);
static_assert(R<=H && C+SOURCE_OFFSET<=W && TILE_GROUPS>0);
template<int M> constexpr uint32_t Pitch = M==2 ? AP : M==3 ? S : O;
template<int M> constexpr uint32_t Capacity = 23000/(Pitch<M>+O);
template<int M> constexpr uint32_t Tile = Capacity<M><TILE_GROUPS ? Capacity<M> : TILE_GROUPS;
static_assert(Tile<3> >= 1, "Full-read baseline requires one group to fit in UB");

template<int M> __simd_vf__ void Relu(__ubuf__ float *out, __ubuf__ float *in, uint32_t count) {
  vector_float a, b;
  vector_uint32_t lane, group, row, col, maskc, maskr, index;
  if constexpr(M==2 || M==3 || (TRANSPOSE && M!=0)) {
    auto all=asc_create_mask_b32(PAT_ALL);
    asc_duplicate_scalar(maskc,C-1,all);
    asc_duplicate_scalar(maskr,R-1,all);
    asc_arange(reinterpret_cast<vector_int32_t &>(lane),0);
    if constexpr(TRANSPOSE) {
      asc_and(row,lane,maskr,all);
      asc_shiftright_scalar(col,lane,__builtin_ctz(R),all);
      asc_and(col,col,maskc,all);
    } else {
      asc_and(col,lane,maskc,all);
      asc_shiftright_scalar(row,lane,__builtin_ctz(C),all);
    }
    asc_shiftright_scalar(group,lane,__builtin_ctz(O),all);
    asc_and(row,row,maskr,all);
    asc_mul_scalar(row,row,(M==1 || M==4 || M==5 || M==6) ? C : W,all);
    asc_mul_scalar(group,group,Pitch<M>,all);
    asc_add(index,group,row,all);
    asc_add(index,index,col,all);
    if constexpr(M==3) asc_add_scalar(index,index,static_cast<uint32_t>(SOURCE_OFFSET),all);
  }
  uint16_t repeats=(count+63)/64;
  for(uint16_t i=0;i<repeats;++i) {
    auto mask=asc_update_mask_b32(count);
    if constexpr(M==2 || M==3 || (TRANSPOSE && M!=0)) {
      uint32_t base=(i*64/O)*Pitch<M>+ (TRANSPOSE ? (i*64%O/R)+(i*64%R)*((M==1 || M==4 || M==5 || M==6) ? C : W) : (i*64%O/C)*W);
      asc_gather(a,in+base,index,mask);
    } else asc_loadalign(a,in+i*64);
    asc_relu(b,a,mask);
    asc_storealign(out+i*64,b,mask);
  }
}

template<int M> __aicore__ inline void CopyIn(__ubuf__ float *in,__gm__ float *x,uint32_t groups) {
  if constexpr(M==0) {
    asc_ndim_copy_gm2ub(in,x+SOURCE_OFFSET,C,R,groups,1,1,0,0,false,
      asc_load_l2_cache_mode::NORMAL_FIRST_VICTIM);
  } else if constexpr(S==O && SOURCE_OFFSET==0) {
    asc_copy_gm2ub_align(in,x,groups*O*4);
  } else if constexpr(M==2) {
    asc_copy_gm2ub_align(in,x+SOURCE_OFFSET,groups,SPAN*4,0,0,false,0,S*4,AP*4);
  } else if constexpr(M==3) {
    asc_copy_gm2ub_align(in,x,groups*S*4);
  } else if constexpr(M==4 && S%8==0) {
    asc_set_gm2ub_loop_size(groups,1);
    asc_set_gm2ub_loop1_stride(S*4,O*4);
    asc_copy_gm2ub_align(in,x+SOURCE_OFFSET,R,C*4,0,0,false,0,W*4,C*4);
    asc_set_gm2ub_loop_size(1,1);
  } else {
    for(uint32_t g=0;g<groups;++g)
      asc_copy_gm2ub_align(in+g*O,x+g*S+SOURCE_OFFSET,R,C*4,0,0,false,0,W*4,C*4);
  }
}

__aicore__ inline void NativeTranspose(__ubuf__ float *out,__ubuf__ float *in,uint32_t groups) {
  if constexpr(R==8) {
    for(uint32_t c=0;c<C;c+=8) {
      __ubuf__ float *src[16], *dst[16];
      for(uint32_t i=0;i<16;++i) {
        src[i]=in+(i/8)*O+(i%8)*C+c;
        dst[i]=out+(i%2)*O+(c+i/2)*R;
      }
      asc_set_va_reg(VA0,dst); asc_set_va_reg(VA1,dst+8);
      asc_set_va_reg(VA2,src); asc_set_va_reg(VA3,src+8);
      uint32_t repeats=(groups+1)/2;
      asc_transto5hd_b32(VA0,VA2,repeats,repeats==1 ? 0 : O/4,repeats==1 ? 0 : O/4);
    }
  } else if constexpr(R>=16) {
    if(C/8>groups && C/8>R/16) {
      for(uint32_t g=0;g<groups;++g) for(uint32_t r=0;r<R;r+=16) {
        __ubuf__ float *src[16], *dst[16];
        for(uint32_t i=0;i<16;++i) {
          src[i]=in+g*O+(r+i)*C;
          dst[i]=out+g*O+(i/2)*R+r+(i%2)*8;
        }
        asc_set_va_reg(VA0,dst); asc_set_va_reg(VA1,dst+8);
        asc_set_va_reg(VA2,src); asc_set_va_reg(VA3,src+8);
        asc_transto5hd_b32(VA0,VA2,C/8,C==8 ? 0 : R,C==8 ? 0 : 1);
      }
    } else if(groups<R/16) {
      for(uint32_t g=0;g<groups;++g) for(uint32_t c=0;c<C;c+=8) {
        __ubuf__ float *src[16], *dst[16];
        for(uint32_t i=0;i<16;++i) {
          src[i]=in+g*O+i*C+c;
          dst[i]=out+g*O+(c+i/2)*R+(i%2)*8;
        }
        asc_set_va_reg(VA0,dst); asc_set_va_reg(VA1,dst+8);
        asc_set_va_reg(VA2,src); asc_set_va_reg(VA3,src+8);
        asc_transto5hd_b32(VA0,VA2,R/16,R==16 ? 0 : 2,R==16 ? 0 : 2*C);
      }
    } else {
      for(uint32_t r=0;r<R;r+=16) for(uint32_t c=0;c<C;c+=8) {
        __ubuf__ float *src[16], *dst[16];
        for(uint32_t i=0;i<16;++i) {
          src[i]=in+(r+i)*C+c;
          dst[i]=out+(c+i/2)*R+r+(i%2)*8;
        }
        asc_set_va_reg(VA0,dst); asc_set_va_reg(VA1,dst+8);
        asc_set_va_reg(VA2,src); asc_set_va_reg(VA3,src+8);
        asc_transto5hd_b32(VA0,VA2,groups,groups==1 ? 0 : O/8,groups==1 ? 0 : O/8);
      }
    }
  }
}

__aicore__ inline void MergedTranspose(__ubuf__ float *out,__ubuf__ float *in,uint32_t groups) {
  if constexpr(R>=16) {
    for(uint32_t c=0;c<C;c+=8) {
      __ubuf__ float *src[16], *dst[16];
      for(uint32_t i=0;i<16;++i) {
        src[i]=in+i*C+c;
        dst[i]=out+(c+i/2)*(groups*R)+(i%2)*8;
      }
      asc_set_va_reg(VA0,dst); asc_set_va_reg(VA1,dst+8);
      asc_set_va_reg(VA2,src); asc_set_va_reg(VA3,src+8);
      uint32_t repeats=groups*R/16;
      asc_transto5hd_b32(VA0,VA2,repeats,repeats==1 ? 0 : 2,repeats==1 ? 0 : 2*C);
    }
  }
}

template<int M> __aicore__ inline void Run(__gm__ float *out,__gm__ float *x,uint32_t groups) {
  asc_init();
  constexpr uint32_t T=Tile<M>, B=(M==5 && R==8) ? (T+1)/2*2 : T;
  constexpr uint32_t I=(B*Pitch<M>+63)/64*64, U=(B*O+63)/64*64;
  __ubuf__ float input[2*I];
  __ubuf__ float output[2*U];
  uint32_t bid=block_idx, blocks=block_num, tasks=(groups+T-1)/T;
  if(bid>=tasks) return;
  uint32_t local=(tasks-1-bid)/blocks+1;
  asc_set_gm2ub_loop_size(1,1);
  if constexpr(M==0) {
    asc_set_ndim_loop0_stride(TRANSPOSE ? R : 1,1);
    asc_set_ndim_loop1_stride(TRANSPOSE ? 1 : C,W);
    asc_set_ndim_loop2_stride(O,S);
    asc_set_ndim_loop3_stride(0,0);
    asc_set_ndim_loop4_stride(0,0);
    asc_ndim_pad_count_config pad{};
    asc_set_ndim_pad_count(pad);
    asc_ndim_copy_dci();
  }
  uint32_t offset=bid*T, count=groups-offset<T ? groups-offset : T;
  CopyIn<M>(input,x+offset*S,count);
  asc_sync_notify(PIPE_MTE2,PIPE_V,EVENT_ID0);
  for(uint32_t i=0;i<local;++i) {
    uint32_t slot=i%2;
    event_t event=slot==0 ? EVENT_ID0 : EVENT_ID1;
    if(i+1<local) {
      uint32_t ns=(i+1)%2;
      event_t ne=ns==0 ? EVENT_ID0 : EVENT_ID1;
      if(i+1>=2) asc_sync_wait(PIPE_V,PIPE_MTE2,ne);
      uint32_t no=(bid+(i+1)*blocks)*T, nc=groups-no<T ? groups-no : T;
      CopyIn<M>(input+ns*I,x+no*S,nc);
      asc_sync_notify(PIPE_MTE2,PIPE_V,ne);
    }
    asc_sync_wait(PIPE_MTE2,PIPE_V,event);
    if(i>=2) asc_sync_wait(PIPE_MTE3,PIPE_V,event);
    offset=(bid+i*blocks)*T; count=groups-offset<T ? groups-offset : T;
    if constexpr(M==6 && TRANSPOSE && R>=16) {
      MergedTranspose(output+slot*U,input+slot*I,count);
      asc_sync_pipe(PIPE_V);
      asc_vf_call<Relu<0>>(output+slot*U,output+slot*U,count*O);
    } else if constexpr(M==5 && TRANSPOSE && R>=8) {
      NativeTranspose(output+slot*U,input+slot*I,count);
      asc_sync_pipe(PIPE_V);
      asc_vf_call<Relu<0>>(output+slot*U,output+slot*U,count*O);
    } else asc_vf_call<Relu<M>>(output+slot*U,input+slot*I,count*O);
    if(i+2<local) asc_sync_notify(PIPE_V,PIPE_MTE2,event);
    asc_sync_notify(PIPE_V,PIPE_MTE3,event);
    asc_sync_wait(PIPE_V,PIPE_MTE3,event);
    if constexpr(M==6 && TRANSPOSE && R>=16) {
      for(uint32_t g=0;g<count;++g)
        asc_copy_ub2gm_align(out+(offset+g)*O,output+slot*U+g*R,C,R*4,0,R*4,count*R*4);
    } else asc_copy_ub2gm_align(out+offset*O,output+slot*U,count*O*4);
    if(i+2<local) asc_sync_notify(PIPE_MTE3,PIPE_V,event);
  }
  asc_sync_pipe(PIPE_ALL);
}
#define KERNEL(Name,Mode) \
__global__ __vector__ void Name(__gm__ float *out,__gm__ float *x,uint32_t groups) { Run<Mode>(out,x,groups); }
KERNEL(SliceNddma,0)
KERNEL(SliceDmaRows,1)
KERNEL(SliceDmaSpanGather,2)
KERNEL(SliceDmaFullGather,3)
KERNEL(SliceDmaLoop,4)
KERNEL(SliceDmaNative,5)
KERNEL(SliceDmaMerged,6)
void Launch(int mode,uint32_t blocks,aclrtStream stream,float *out,float *x,uint32_t groups) {
  if(mode==0) SliceNddma<<<blocks,0,stream>>>(out,x,groups);
  if(mode==1) SliceDmaRows<<<blocks,0,stream>>>(out,x,groups);
  if(mode==2) SliceDmaSpanGather<<<blocks,0,stream>>>(out,x,groups);
  if(mode==3) SliceDmaFullGather<<<blocks,0,stream>>>(out,x,groups);
  if(mode==4) SliceDmaLoop<<<blocks,0,stream>>>(out,x,groups);
  if(mode==5) SliceDmaNative<<<blocks,0,stream>>>(out,x,groups);
  if(mode==6) SliceDmaMerged<<<blocks,0,stream>>>(out,x,groups);
}
void Check(aclError code,const char *what) {
  if(code!=ACL_SUCCESS) { std::fprintf(stderr,"ACL_FAILURE %s %d\n",what,(int)code); std::exit(2); }
}
bool Verify(const std::vector<float>& out,const std::vector<float>& ref) {
  for(size_t i=0;i<out.size();++i) {
    float expected=i>=64 && i<ref.size()+64 ? ref[i-64] : -12345.0f;
    if(out[i]!=expected) { std::fprintf(stderr,"MISMATCH i=%zu got=%g expected=%g\n",i,out[i],expected); return false; }
  }
  return true;
}
int Case(uint32_t groups,uint32_t blocks,int rounds,aclrtStream stream) {
  if(!groups || groups>65536 || !blocks || blocks>64 || uint64_t(groups)*S*4>512*1024*1024) return 2;
  std::vector<float> input(groups*S+64), golden(groups*O), output(groups*O+128,-12345.0f);
  float *x=nullptr,*y=nullptr;
  Check(aclrtMalloc((void**)&x,input.size()*4,ACL_MEM_MALLOC_HUGE_FIRST),"input");
  Check(aclrtMalloc((void**)&y,output.size()*4,ACL_MEM_MALLOC_HUGE_FIRST),"output");
  std::printf("CONFIG,groups=%u,blocks=%u,rounds=%d,H=%u,W=%u,R=%u,C=%u,tiles=%u:%u:%u:%u:%u:%u\n",groups,blocks,rounds,H,W,R,C,Tile<0>,Tile<1>,Tile<2>,Tile<3>,Tile<4>,Tile<5>);
  for(int pattern=0;pattern<3;++pattern) {
    uint32_t rng=12345+pattern;
    for(auto &v:input) { rng=rng*1664525u+1013904223u; v=static_cast<int32_t>(rng%65535)-32767; }
    for(uint32_t g=0;g<groups;++g) for(uint32_t r=0;r<R;++r) for(uint32_t c=0;c<C;++c)
      golden[g*O+(TRANSPOSE ? c*R+r : r*C+c)]=std::max(0.0f,input[g*S+r*W+c+SOURCE_OFFSET]);
    Check(aclrtMemcpy(x,input.size()*4,input.data(),input.size()*4,ACL_MEMCPY_HOST_TO_DEVICE),"upload");
    for(int m=0;m<MODES;++m) {
      std::fill(output.begin(),output.end(),-12345.0f);
      Check(aclrtMemcpy(y,output.size()*4,output.data(),output.size()*4,ACL_MEMCPY_HOST_TO_DEVICE),"poison");
      Launch(m,blocks,stream,y+64,x,groups);
      Check(aclrtSynchronizeStream(stream),"correctness execution");
      Check(aclrtMemcpy(output.data(),output.size()*4,y,output.size()*4,ACL_MEMCPY_DEVICE_TO_HOST),"download");
      if(!Verify(output,golden)) return 3;
      std::printf("PASS,pattern=%d,mode=%d\n",pattern,m);
    }
  }
  if(rounds) {
    for(int w=0;w<20;++w) for(int m=0;m<MODES;++m) Launch(m,blocks,stream,y+64,x,groups);
    Check(aclrtSynchronizeStream(stream),"warmup");
    for(int r=0;r<rounds;++r) for(int j=0;j<MODES;++j) {
      int m=(r+j)%MODES;
      Launch(m,blocks,stream,y+64,x,groups);
      Check(aclrtSynchronizeStream(stream),"timed execution");
      if(r==rounds-1) {
        Check(aclrtMemcpy(output.data(),output.size()*4,y,output.size()*4,ACL_MEMCPY_DEVICE_TO_HOST),"post-timing download");
        if(!Verify(output,golden)) return 3;
        std::printf("POST_CHECK,mode=%d,status=PASS\n",m);
      }
    }
  }
  aclrtFree(x); aclrtFree(y); return 0;
}
int main(int argc,char **argv) {
  std::setvbuf(stdout,nullptr,_IOLBF,0);
  if(argc<4) return 2;
  int rounds=std::atoi(argv[1]),device=std::atoi(argv[2]);
  if(rounds<0 || rounds>1000 || device<0 || device>1) return 2;
  Check(aclInit(nullptr),"init"); Check(aclrtSetDevice(device),"device");
  aclrtStream stream=nullptr; Check(aclrtCreateStream(&stream),"stream");
  int status=0;
  for(int i=3;i<argc && !status;++i) {
    uint32_t groups=0,blocks=0; char extra;
    if(std::sscanf(argv[i],"%u:%u%c",&groups,&blocks,&extra)!=2) return 2;
    status=Case(groups,blocks,rounds,stream);
  }
  aclrtDestroyStream(stream); aclrtResetDevice(device); aclFinalize(); return status;
}
