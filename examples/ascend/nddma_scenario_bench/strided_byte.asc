#include <algorithm>
#include <cstdint>
#include <cstdio>
#include <cstdlib>
#include <cstring>
#include <vector>
#include <type_traits>
#include "acl/acl.h"
#include "c_api/asc_simd.h"
#include "simt_api/asc_simt.h"
#ifndef TRANSPOSE
#define TRANSPOSE 0
#endif
#ifndef SOURCE_OFFSET
#define SOURCE_OFFSET 1
#endif
#ifndef SOURCE_ROWS
#define SOURCE_ROWS 17
#endif
#ifndef SOURCE_COLS
#define SOURCE_COLS 65
#endif
#ifndef TAKE_ROWS
#define TAKE_ROWS 4
#endif
#ifndef TAKE_COLS
#define TAKE_COLS 16
#endif
#ifndef TILE_GROUPS
#define TILE_GROUPS 32
#endif
constexpr uint32_t H=SOURCE_ROWS, W=SOURCE_COLS, R=TAKE_ROWS, C=TAKE_COLS;
constexpr uint32_t O=R*C, S=H*W, STEP=W/C, SPAN=(R-1)*W+(C-1)*(W/C)+1, AP=(SPAN+7)/8*8;
constexpr int MODES=8;
using DmaType = std::conditional_t<TRANSPOSE==0,fp8_e4m3fn_t,fp8_e8m0_t>;
static_assert(R>0 && (R&(R-1))==0 && C>=128 && (C&(C-1))==0);
static_assert(R==1 && H==1 && W%C==0 && STEP>=32 && STEP<=512 && (STEP&(STEP-1))==0 && SOURCE_OFFSET==0 && TILE_GROUPS>0);
template<int M> constexpr uint32_t Pitch = (M==1 || M==6) ? 32*O : M==2 ? S : O;
template<int M> constexpr uint32_t Capacity = 92000/(Pitch<M>+O);
template<int M> constexpr uint32_t Tile = Capacity<M><TILE_GROUPS ? Capacity<M> : TILE_GROUPS;
static_assert(Tile<6>*O<=4095, "Burst baseline exceeds the DMA n_burst limit");
static_assert(Tile<2> >= 1, "Full-read baseline requires one group to fit in UB");

template<int M> __simd_vf__ void Gather(__ubuf__ uint8_t *out,__ubuf__ uint8_t *in,uint32_t count) {
  vector_uint16_t a,lane,index;
  auto all=asc_create_mask_b16(PAT_ALL);
  asc_arange(reinterpret_cast<vector_int16_t &>(lane),0);
  asc_mul_scalar(index,lane,uint16_t((M==1 || M==6) ? 32 : STEP),all);
  uint16_t repeats=(count+127)/128;
  for(uint16_t i=0;i<repeats;++i) {
    auto mask=asc_update_mask_b16(count);
    asc_gather(a,in+i*128*((M==1 || M==6) ? 32 : STEP),index,mask);
    asc_storealign_pack(reinterpret_cast<__ubuf__ uint16_t *>(out+i*128),a,mask);
  }
}
template<int M> __aicore__ inline void CopyIn(__ubuf__ uint8_t *in,__gm__ uint8_t *x,uint32_t groups) {
  if constexpr(M==0) {
    asc_ndim_copy_gm2ub(reinterpret_cast<__ubuf__ DmaType *>(in),reinterpret_cast<__gm__ DmaType *>(x),groups*O,1,1,1,1,0,0,false,asc_load_l2_cache_mode::NORMAL_FIRST_VICTIM);
  } else if constexpr(M==7) {
    asc_set_gm2ub_loop_size(groups,1); asc_set_gm2ub_loop1_stride(S,O);
    asc_copy_gm2ub_align(in,x,O,1,0,0,false,0,STEP,1);
    asc_set_gm2ub_loop_size(1,1);
  } else if constexpr(M==6) {
    asc_copy_gm2ub_align(in,x,groups*O,32,0,0,false,0,STEP,32);
  } else if constexpr(M==1) {
    asc_copy_gm2ub_align(in,x,groups*O,1,0,0,false,0,STEP,32);
  } else asc_copy_gm2ub_align(in,x,groups*S);
}
template<int M> __aicore__ inline void RunCompact(__gm__ uint8_t *out,__gm__ uint8_t *x,uint32_t groups) {
  asc_init(); constexpr uint32_t T=Tile<M>, I=(T*O+255)/256*256;
  __ubuf__ uint8_t input[2*I];
  uint32_t bid=block_idx,blocks=block_num,tasks=(groups+T-1)/T;
  if(bid>=tasks) return;
  uint32_t local=(tasks-1-bid)/blocks+1;
  if constexpr(M==0) {
  asc_set_ndim_loop0_stride(1,STEP); asc_set_ndim_loop1_stride(0,0);
  asc_set_ndim_loop2_stride(0,0); asc_set_ndim_loop3_stride(0,0); asc_set_ndim_loop4_stride(0,0);
  asc_ndim_pad_count_config pad{}; asc_set_ndim_pad_count(pad); asc_ndim_copy_dci();
  }
  uint32_t offset=bid*T,count=groups-offset<T ? groups-offset : T;
  CopyIn<M>(input,x+offset*S,count); asc_sync_notify(PIPE_MTE2,PIPE_MTE3,EVENT_ID0);
  for(uint32_t i=0;i<local;++i) {
    uint32_t slot=i%2; event_t event=slot==0 ? EVENT_ID0 : EVENT_ID1;
    if(i+1<local) {
      uint32_t ns=(i+1)%2; event_t ne=ns==0 ? EVENT_ID0 : EVENT_ID1;
      if(i+1>=2) asc_sync_wait(PIPE_MTE3,PIPE_MTE2,ne);
      uint32_t no=(bid+(i+1)*blocks)*T,nc=groups-no<T ? groups-no : T;
      CopyIn<M>(input+ns*I,x+no*S,nc); asc_sync_notify(PIPE_MTE2,PIPE_MTE3,ne);
    }
    asc_sync_wait(PIPE_MTE2,PIPE_MTE3,event);
    offset=(bid+i*blocks)*T; count=groups-offset<T ? groups-offset : T;
    asc_copy_ub2gm_align(out+offset*O,input+slot*I,count*O);
    if(i+2<local) asc_sync_notify(PIPE_MTE3,PIPE_MTE2,event);
  }
  asc_sync_pipe(PIPE_ALL);
}
template<int M> __aicore__ inline void Run(__gm__ uint8_t *out,__gm__ uint8_t *x,uint32_t groups) {
  asc_init();
  constexpr uint32_t T=Tile<M>, B=T;
  constexpr uint32_t I=(B*Pitch<M>+63)/64*64, U=(B*O+63)/64*64;
  __ubuf__ uint8_t input[2*I];
  __ubuf__ uint8_t output[2*U];
  uint32_t bid=block_idx, blocks=block_num, tasks=(groups+T-1)/T;
  if(bid>=tasks) return;
  uint32_t local=(tasks-1-bid)/blocks+1;
  asc_set_gm2ub_loop_size(1,1);
  if constexpr(M==0) {
    asc_set_ndim_loop0_stride(1,STEP);
    asc_set_ndim_loop1_stride(0,0);
    asc_set_ndim_loop2_stride(0,0);
    asc_set_ndim_loop3_stride(0,0);
    asc_set_ndim_loop4_stride(0,0);
    asc_ndim_pad_count_config pad{};
    asc_set_ndim_pad_count(pad);
    asc_ndim_copy_dci();
  }
  uint32_t offset=bid*T, count=groups-offset<T ? groups-offset : T;
  CopyIn<M>(input,x+offset*S,count);
  asc_sync_notify(PIPE_MTE2,PIPE_V,EVENT_ID0);
  for(uint32_t i=0;i<local;++i) {
    uint32_t slot=i%2;
    event_t event=slot==0 ? EVENT_ID0 : EVENT_ID1;
    if(i+1<local) {
      uint32_t ns=(i+1)%2;
      event_t ne=ns==0 ? EVENT_ID0 : EVENT_ID1;
      if(i+1>=2) asc_sync_wait(PIPE_V,PIPE_MTE2,ne);
      uint32_t no=(bid+(i+1)*blocks)*T, nc=groups-no<T ? groups-no : T;
      CopyIn<M>(input+ns*I,x+no*S,nc);
      asc_sync_notify(PIPE_MTE2,PIPE_V,ne);
    }
    asc_sync_wait(PIPE_MTE2,PIPE_V,event);
    if(i>=2) asc_sync_wait(PIPE_MTE3,PIPE_V,event);
    offset=(bid+i*blocks)*T; count=groups-offset<T ? groups-offset : T;
    asc_vf_call<Gather<M>>(output+slot*U,input+slot*I,count*O);
    if(i+2<local) asc_sync_notify(PIPE_V,PIPE_MTE2,event);
    asc_sync_notify(PIPE_V,PIPE_MTE3,event);
    asc_sync_wait(PIPE_V,PIPE_MTE3,event);
    asc_copy_ub2gm_align(out+offset*O,output+slot*U,count*O);
    if(i+2<local) asc_sync_notify(PIPE_MTE3,PIPE_V,event);
  }
  asc_sync_pipe(PIPE_ALL);
}
#define KERNEL(Name,Mode) \
__global__ __vector__ void Name(__gm__ uint8_t *out,__gm__ uint8_t *x,uint32_t groups) { Run<Mode>(out,x,groups); }
__global__ __vector__ void ByteNddma(__gm__ uint8_t *out,__gm__ uint8_t *x,uint32_t groups) { RunCompact<0>(out,x,groups); }
KERNEL(ByteDmaBurst,1)
KERNEL(ByteDmaFull,2)
KERNEL(ByteDmaBurst32,6)
__global__ __vector__ void ByteDmaCompact(__gm__ uint8_t *out,__gm__ uint8_t *x,uint32_t groups) { RunCompact<7>(out,x,groups); }
template<int Threads,bool Packed> __simt_vf__ __launch_bounds__(Threads) inline void SimtExtract(
    __gm__ uint8_t *out,__gm__ uint8_t *x,uint32_t n,uint32_t bid,uint32_t blocks) {
  for(uint32_t i=bid*blockDim.x+threadIdx.x;i<(Packed ? n/4 : n);i+=blocks*blockDim.x) {
    if constexpr(Packed) {
      uint32_t v=uint32_t(x[(4*i)*STEP]) | (uint32_t(x[(4*i+1)*STEP])<<8) |
                 (uint32_t(x[(4*i+2)*STEP])<<16) | (uint32_t(x[(4*i+3)*STEP])<<24);
      reinterpret_cast<__gm__ uint32_t *>(out)[i]=v;
    } else out[i]=x[i*STEP];
  }
}
__global__ __vector__ void ByteSimt256(__gm__ uint8_t *out,__gm__ uint8_t *x,uint32_t groups) {
  asc_vf_call<SimtExtract<256,false>>(dim3(256),out,x,groups*O,uint32_t(block_idx),uint32_t(block_num));
}
__global__ __vector__ void ByteSimt512(__gm__ uint8_t *out,__gm__ uint8_t *x,uint32_t groups) {
  asc_vf_call<SimtExtract<512,false>>(dim3(512),out,x,groups*O,uint32_t(block_idx),uint32_t(block_num));
}
__global__ __vector__ void ByteSimtPacked(__gm__ uint8_t *out,__gm__ uint8_t *x,uint32_t groups) {
  asc_vf_call<SimtExtract<256,true>>(dim3(256),out,x,groups*O,uint32_t(block_idx),uint32_t(block_num));
}
void Launch(int mode,uint32_t blocks,aclrtStream stream,uint8_t *out,uint8_t *x,uint32_t groups) {
  if(mode==0) ByteNddma<<<blocks,0,stream>>>(out,x,groups);
  if(mode==1) ByteDmaBurst<<<blocks,0,stream>>>(out,x,groups);
  if(mode==2) ByteDmaFull<<<blocks,0,stream>>>(out,x,groups);
  if(mode==3) ByteSimt256<<<blocks,0,stream>>>(out,x,groups);
  if(mode==4) ByteSimt512<<<blocks,0,stream>>>(out,x,groups);
  if(mode==5) ByteSimtPacked<<<blocks,0,stream>>>(out,x,groups);
  if(mode==6) ByteDmaBurst32<<<blocks,0,stream>>>(out,x,groups);
  if(mode==7) ByteDmaCompact<<<blocks,0,stream>>>(out,x,groups);
}
void Check(aclError code,const char *what) {
  if(code!=ACL_SUCCESS) { std::fprintf(stderr,"ACL_FAILURE %s %d\n",what,(int)code); std::exit(2); }
}
bool Verify(const std::vector<uint8_t>& out,const std::vector<uint8_t>& ref) {
  for(size_t i=0;i<out.size();++i) {
    uint8_t expected=i>=64 && i<ref.size()+64 ? ref[i-64] : uint8_t(0xa5);
    if(out[i]!=expected) { std::fprintf(stderr,"MISMATCH i=%zu got=%u expected=%u\n",i,out[i],expected); return false; }
  }
  return true;
}
int Case(uint32_t groups,uint32_t blocks,int rounds,aclrtStream stream) {
  if(!groups || groups>65536 || !blocks || blocks>64 || uint64_t(groups)*S>512*1024*1024) return 2;
  std::vector<uint8_t> input(groups*S+64), golden(groups*O), output(groups*O+128,uint8_t(0xa5));
  uint8_t *x=nullptr,*y=nullptr;
  Check(aclrtMalloc((void**)&x,input.size(),ACL_MEM_MALLOC_HUGE_FIRST),"input");
  Check(aclrtMalloc((void**)&y,output.size(),ACL_MEM_MALLOC_HUGE_FIRST),"output");
  std::printf("CONFIG,groups=%u,blocks=%u,rounds=%d,H=%u,W=%u,R=%u,C=%u,tiles=%u:%u:%u:%u:%u:%u\n",groups,blocks,rounds,H,W,R,C,Tile<0>,Tile<1>,Tile<2>,Tile<3>,Tile<4>,Tile<5>);
  for(int pattern=0;pattern<3;++pattern) {
    uint32_t rng=12345+pattern;
    for(auto &v:input) { rng=rng*1664525u+1013904223u; v=static_cast<uint8_t>(rng>>16); }
    for(uint32_t g=0;g<groups;++g) for(uint32_t r=0;r<R;++r) for(uint32_t c=0;c<C;++c)
      golden[g*O+r*C+c]=input[g*S+r*W+c*STEP+SOURCE_OFFSET];
    Check(aclrtMemcpy(x,input.size(),input.data(),input.size(),ACL_MEMCPY_HOST_TO_DEVICE),"upload");
    for(int m=0;m<MODES;++m) {
      std::fill(output.begin(),output.end(),uint8_t(0xa5));
      Check(aclrtMemcpy(y,output.size(),output.data(),output.size(),ACL_MEMCPY_HOST_TO_DEVICE),"poison");
      Launch(m,blocks,stream,y+64,x,groups);
      Check(aclrtSynchronizeStream(stream),"correctness execution");
      Check(aclrtMemcpy(output.data(),output.size(),y,output.size(),ACL_MEMCPY_DEVICE_TO_HOST),"download");
      if(!Verify(output,golden)) return 3;
      std::printf("PASS,pattern=%d,mode=%d\n",pattern,m);
    }
  }
  if(rounds) {
    for(int w=0;w<20;++w) for(int m=0;m<MODES;++m) Launch(m,blocks,stream,y+64,x,groups);
    Check(aclrtSynchronizeStream(stream),"warmup");
    for(int r=0;r<rounds;++r) for(int j=0;j<MODES;++j) {
      int m=(r+j)%MODES;
      Launch(m,blocks,stream,y+64,x,groups);
      Check(aclrtSynchronizeStream(stream),"timed execution");
      if(r==rounds-1) {
        Check(aclrtMemcpy(output.data(),output.size(),y,output.size(),ACL_MEMCPY_DEVICE_TO_HOST),"post-timing download");
        if(!Verify(output,golden)) return 3;
        std::printf("POST_CHECK,mode=%d,status=PASS\n",m);
      }
    }
  }
  aclrtFree(x); aclrtFree(y); return 0;
}
int main(int argc,char **argv) {
  std::setvbuf(stdout,nullptr,_IOLBF,0);
  if(argc<4) return 2;
  int rounds=std::atoi(argv[1]),device=std::atoi(argv[2]);
  if(rounds<0 || rounds>1000 || device<0 || device>1) return 2;
  Check(aclInit(nullptr),"init"); Check(aclrtSetDevice(device),"device");
  aclrtStream stream=nullptr; Check(aclrtCreateStream(&stream),"stream");
  int status=0;
  for(int i=3;i<argc && !status;++i) {
    uint32_t groups=0,blocks=0; char extra;
    if(std::sscanf(argv[i],"%u:%u%c",&groups,&blocks,&extra)!=2) return 2;
    status=Case(groups,blocks,rounds,stream);
  }
  aclrtDestroyStream(stream); aclrtResetDevice(device); aclFinalize(); return status;
}
