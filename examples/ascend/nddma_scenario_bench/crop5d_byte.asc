#include <algorithm>
#include <cstdint>
#include <cstdio>
#include <cstdlib>
#include <cstring>
#include <vector>
#include <type_traits>
#include "acl/acl.h"
#include "c_api/asc_simd.h"
#include "simt_api/asc_simt.h"
#ifndef TRANSPOSE
#define TRANSPOSE 0
#endif
#ifndef SOURCE_OFFSET
#define SOURCE_OFFSET 1
#endif
#ifndef SOURCE_ROWS
#define SOURCE_ROWS 17
#endif
#ifndef SOURCE_COLS
#define SOURCE_COLS 65
#endif
#ifndef TAKE_ROWS
#define TAKE_ROWS 4
#endif
#ifndef TAKE_COLS
#define TAKE_COLS 16
#endif
#ifndef TILE_GROUPS
#define TILE_GROUPS 32
#endif
constexpr uint32_t H=SOURCE_ROWS, W=SOURCE_COLS, R=TAKE_ROWS, C=TAKE_COLS;
constexpr uint32_t O=R*R*R*C, S=H*H*H*W, SPAN=(R-1)*W+C, PS=R*R*SPAN, AS=(SPAN+31)/32*32, PA=R*R*AS;
constexpr int MODES=8;
static_assert(R>0 && (R&(R-1))==0 && C>=8 && (C&(C-1))==0 && R<=H && C<=W);
static_assert(R*C<=128 && (R*SPAN)%32==0 && (PS%32)==0);
static_assert(O>=128 && S<=65536 && (R*C)%32==0 && (H*W)%32==0 && TILE_GROUPS>0);
template<int M> constexpr uint32_t Pitch = M==3 ? S : M==4 ? PS : M==7 ? PA : O;
template<int M> constexpr uint32_t Capacity = 90000/(Pitch<M>+O);
template<int M> constexpr uint32_t Tile = Capacity<M><TILE_GROUPS ? Capacity<M> : TILE_GROUPS;
static_assert(Tile<3> >= 1, "Full-read baseline must fit one group in UB");
__simd_vf__ void Gather(__ubuf__ uint8_t *out,__ubuf__ uint8_t *in,uint32_t groups) {
  vector_uint16_t lane,t,col,a,b,c,idx,mc,mr,v;
  auto all=asc_create_mask_b16(PAT_ALL);
  asc_arange(reinterpret_cast<vector_int16_t &>(lane),0);
  asc_duplicate_scalar(mc,uint16_t(C-1),all); asc_duplicate_scalar(mr,uint16_t(R-1),all);
  for(uint16_t j=0;j<O/128;++j) {
    asc_add_scalar(t,lane,uint16_t(j*128),all);
    asc_and(col,t,mc,all); asc_shiftright_scalar(a,t,__builtin_ctz(C),all); asc_and(a,a,mr,all);
    asc_shiftright_scalar(b,t,__builtin_ctz(C)+__builtin_ctz(R),all); asc_and(b,b,mr,all);
    asc_shiftright_scalar(c,t,__builtin_ctz(C)+2*__builtin_ctz(R),all);
    asc_mul_scalar(a,a,uint16_t(W),all); asc_mul_scalar(b,b,uint16_t(H*W),all);
    asc_mul_scalar(c,c,uint16_t(H*H*W),all); asc_add(idx,col,a,all); asc_add(idx,idx,b,all); asc_add(idx,idx,c,all);
    for(uint16_t g=0;g<groups;++g) {
      asc_gather(v,in+g*S,idx,all);
      asc_storealign_pack(reinterpret_cast<__ubuf__ uint16_t *>(out+g*O+j*128),v,all);
    }
  }
}
template<int M> __simd_vf__ void GatherSpan(__ubuf__ uint8_t *out,__ubuf__ uint8_t *in,uint32_t groups) {
  constexpr uint32_t SP=M==7 ? AS : SPAN;
  vector_uint16_t lane,row,col,channel,idx,mr,mc,v;
  auto all=asc_create_mask_b16(PAT_ALL);
  asc_arange(reinterpret_cast<vector_int16_t &>(lane),0);
  asc_duplicate_scalar(mr,uint16_t(R-1),all); asc_duplicate_scalar(mc,uint16_t(C-1),all);
  asc_and(channel,lane,mc,all); asc_shiftright_scalar(col,lane,__builtin_ctz(C),all); asc_and(col,col,mr,all);
  asc_shiftright_scalar(row,lane,__builtin_ctz(R*C),all);
  asc_mul_scalar(row,row,uint16_t(SP),all); asc_mul_scalar(col,col,uint16_t(W),all);
  asc_add(idx,row,col,all); asc_add(idx,idx,channel,all);
  for(uint16_t i=0;i<groups*O/128;++i) {
    asc_gather(v,in+i*128/(R*C)*SP,idx,all);
    asc_storealign_pack(reinterpret_cast<__ubuf__ uint16_t *>(out+i*128),v,all);
  }
}
template<int M> __aicore__ inline void CopyIn(__ubuf__ uint8_t *in,__gm__ uint8_t *x,uint32_t groups) {
  if constexpr(M==0) {
    asc_ndim_copy_gm2ub(reinterpret_cast<__ubuf__ fp8_e4m3fn_t *>(in),reinterpret_cast<__gm__ fp8_e4m3fn_t *>(x),
        C,R,R,R,groups,0,0,false,asc_load_l2_cache_mode::NORMAL_FIRST_VICTIM);
  } else if constexpr(M==1) {
    for(uint32_t g=0;g<groups;++g) asc_copy_gm2ub_align(in+g*O,x+g*S,R,C,0,0,false,0,W,C);
  } else if constexpr(M==2) {
    if(groups!=Tile<M>) asc_set_gm2ub_loop_size(R,groups);
    for(uint32_t a=0;a<R;++a) asc_copy_gm2ub_align(in+a*R*R*C,x+a*H*H*W,R,C,0,0,false,0,W,C);
  } else if constexpr(M==4 || M==7) {
    constexpr uint32_t SP=M==7 ? AS : SPAN;
    if(groups!=Tile<M>) asc_set_gm2ub_loop_size(R,groups);
    asc_copy_gm2ub_align(in,x,R,SP,0,0,false,0,H*W,SP);
  } else asc_copy_gm2ub_align(in,x,groups*S);
}
template<int M> __aicore__ inline void Run(__gm__ uint8_t *out,__gm__ uint8_t *x,uint32_t groups) {
  asc_init(); constexpr uint32_t T=Tile<M>, I=(T*Pitch<M>+255)/256*256, U=(T*O+255)/256*256;
  __ubuf__ uint8_t input[2*I]; __ubuf__ uint8_t output[(M==3 || M==4 || M==7) ? 2*U : 32];
  asc_set_gm2ub_loop_size(1,1);
  uint32_t bid=block_idx,blocks=block_num,tasks=(groups+T-1)/T;
  if(bid>=tasks) return;
  uint32_t local=(tasks-1-bid)/blocks+1;
  if constexpr(M==0) {
    asc_set_ndim_loop0_stride(1,1); asc_set_ndim_loop1_stride(C,W); asc_set_ndim_loop2_stride(R*C,H*W);
    asc_set_ndim_loop3_stride(R*R*C,H*H*W); asc_set_ndim_loop4_stride(O,S);
    asc_ndim_pad_count_config pad{}; asc_set_ndim_pad_count(pad); asc_ndim_copy_dci();
  }
  if constexpr(M==1) {
    asc_set_gm2ub_loop_size(R,R); asc_set_gm2ub_loop1_stride(H*W,R*C); asc_set_gm2ub_loop2_stride(H*H*W,R*R*C);
  } else if constexpr(M==2) {
    asc_set_gm2ub_loop_size(R,T); asc_set_gm2ub_loop1_stride(H*W,R*C); asc_set_gm2ub_loop2_stride(S,O);
  } else if constexpr(M==4 || M==7) {
    constexpr uint32_t SP=M==7 ? AS : SPAN;
    asc_set_gm2ub_loop_size(R,T); asc_set_gm2ub_loop1_stride(H*H*W,R*SP); asc_set_gm2ub_loop2_stride(S,R*R*SP);
  }
  constexpr pipe_t Consumer=(M==3 || M==4 || M==7) ? PIPE_V : PIPE_MTE3;
  uint32_t offset=bid*T,count=groups-offset<T ? groups-offset : T;
  CopyIn<M>(input,x+offset*S,count); asc_sync_notify(PIPE_MTE2,Consumer,EVENT_ID0);
  for(uint32_t i=0;i<local;++i) {
    uint32_t slot=i%2; event_t event=slot==0 ? EVENT_ID0 : EVENT_ID1;
    if(i+1<local) {
      uint32_t ns=(i+1)%2; event_t ne=ns==0 ? EVENT_ID0 : EVENT_ID1;
      if(i+1>=2) asc_sync_wait(Consumer,PIPE_MTE2,ne);
      uint32_t no=(bid+(i+1)*blocks)*T,nc=groups-no<T ? groups-no : T;
      CopyIn<M>(input+ns*I,x+no*S,nc); asc_sync_notify(PIPE_MTE2,Consumer,ne);
    }
    asc_sync_wait(PIPE_MTE2,Consumer,event);
    offset=(bid+i*blocks)*T; count=groups-offset<T ? groups-offset : T;
    if constexpr(M==3 || M==4 || M==7) {
      if(i>=2) asc_sync_wait(PIPE_MTE3,PIPE_V,event);
      if constexpr(M==3) asc_vf_call<Gather>(output+slot*U,input+slot*I,count);
      else asc_vf_call<GatherSpan<M>>(output+slot*U,input+slot*I,count);
      if(i+2<local) asc_sync_notify(PIPE_V,PIPE_MTE2,event);
      asc_sync_notify(PIPE_V,PIPE_MTE3,event); asc_sync_wait(PIPE_V,PIPE_MTE3,event);
      asc_copy_ub2gm_align(out+offset*O,output+slot*U,count*O);
      if(i+2<local) asc_sync_notify(PIPE_MTE3,PIPE_V,event);
    } else {
      asc_copy_ub2gm_align(out+offset*O,input+slot*I,count*O);
      if(i+2<local) asc_sync_notify(PIPE_MTE3,PIPE_MTE2,event);
    }
  }
  asc_sync_pipe(PIPE_ALL);
  asc_set_gm2ub_loop_size(1,1);
}
#define KERNEL(Name,Mode) \
__global__ __vector__ void Name(__gm__ uint8_t *out,__gm__ uint8_t *x,uint32_t groups) { Run<Mode>(out,x,groups); }
KERNEL(CropNddma,0)
KERNEL(CropDmaGroups,1)
KERNEL(CropDmaAxis,2)
KERNEL(CropDmaFull,3)
KERNEL(CropDmaSpan,4)
KERNEL(CropDmaAlignedSpan,7)
template<int Threads> __simt_vf__ __launch_bounds__(Threads) inline void SimtCrop(
    __gm__ uint8_t *out,__gm__ uint8_t *x,uint32_t n,uint32_t bid,uint32_t blocks) {
  for(uint32_t i=bid*blockDim.x+threadIdx.x;i<n/4;i+=blocks*blockDim.x) {
    uint32_t q=i*4,g=q/O,d=q%C,c=(q/C)%R,b=(q/(R*C))%R,a=(q/(R*R*C))%R;
    reinterpret_cast<__gm__ uint32_t *>(out)[i]=*reinterpret_cast<__gm__ uint32_t *>(x+g*S+((a*H+b)*H+c)*W+d);
  }
}
__global__ __vector__ void CropSimt256(__gm__ uint8_t *out,__gm__ uint8_t *x,uint32_t groups) {
  asc_vf_call<SimtCrop<256>>(dim3(256),out,x,groups*O,uint32_t(block_idx),uint32_t(block_num));
}
__global__ __vector__ void CropSimt512(__gm__ uint8_t *out,__gm__ uint8_t *x,uint32_t groups) {
  asc_vf_call<SimtCrop<512>>(dim3(512),out,x,groups*O,uint32_t(block_idx),uint32_t(block_num));
}
void Launch(int mode,uint32_t blocks,aclrtStream stream,uint8_t *out,uint8_t *x,uint32_t groups) {
  if(mode==0) CropNddma<<<blocks,0,stream>>>(out,x,groups);
  if(mode==1) CropDmaGroups<<<blocks,0,stream>>>(out,x,groups);
  if(mode==2) CropDmaAxis<<<blocks,0,stream>>>(out,x,groups);
  if(mode==3) CropDmaFull<<<blocks,0,stream>>>(out,x,groups);
  if(mode==4) CropDmaSpan<<<blocks,0,stream>>>(out,x,groups);
  if(mode==5) CropSimt256<<<blocks,0,stream>>>(out,x,groups);
  if(mode==6) CropSimt512<<<blocks,0,stream>>>(out,x,groups);
  if(mode==7) CropDmaAlignedSpan<<<blocks,0,stream>>>(out,x,groups);
}
void Check(aclError code,const char *what) {
  if(code!=ACL_SUCCESS) { std::fprintf(stderr,"ACL_FAILURE %s %d\n",what,(int)code); std::exit(2); }
}
bool Verify(const std::vector<uint8_t>& out,const std::vector<uint8_t>& ref) {
  for(size_t i=0;i<out.size();++i) {
    uint8_t expected=i>=64 && i<ref.size()+64 ? ref[i-64] : uint8_t(0xa5);
    if(out[i]!=expected) { std::fprintf(stderr,"MISMATCH i=%zu got=%u expected=%u\n",i,out[i],expected); return false; }
  }
  return true;
}
int Case(uint32_t groups,uint32_t blocks,int rounds,aclrtStream stream) {
  if(!groups || groups>65536 || !blocks || blocks>64 || uint64_t(groups)*S>512*1024*1024) return 2;
  std::vector<uint8_t> input(groups*S+64), golden(groups*O), output(groups*O+128,uint8_t(0xa5));
  uint8_t *x=nullptr,*y=nullptr;
  Check(aclrtMalloc((void**)&x,input.size(),ACL_MEM_MALLOC_HUGE_FIRST),"input");
  Check(aclrtMalloc((void**)&y,output.size(),ACL_MEM_MALLOC_HUGE_FIRST),"output");
  std::printf("CONFIG,groups=%u,blocks=%u,rounds=%d,H=%u,W=%u,R=%u,C=%u,tiles=%u:%u:%u:%u:%u:%u\n",groups,blocks,rounds,H,W,R,C,Tile<0>,Tile<1>,Tile<2>,Tile<3>,Tile<4>,Tile<5>);
  for(int pattern=0;pattern<3;++pattern) {
    uint32_t rng=12345+pattern;
    for(auto &v:input) { rng=rng*1664525u+1013904223u; v=static_cast<uint8_t>(rng>>16); }
    for(uint32_t g=0;g<groups;++g) for(uint32_t a=0;a<R;++a) for(uint32_t b=0;b<R;++b)
      for(uint32_t c=0;c<R;++c) for(uint32_t d=0;d<C;++d)
        golden[g*O+((a*R+b)*R+c)*C+d]=input[g*S+((a*H+b)*H+c)*W+d];
    Check(aclrtMemcpy(x,input.size(),input.data(),input.size(),ACL_MEMCPY_HOST_TO_DEVICE),"upload");
    for(int m=0;m<MODES;++m) {
      std::fill(output.begin(),output.end(),uint8_t(0xa5));
      Check(aclrtMemcpy(y,output.size(),output.data(),output.size(),ACL_MEMCPY_HOST_TO_DEVICE),"poison");
      Launch(m,blocks,stream,y+64,x,groups);
      Check(aclrtSynchronizeStream(stream),"correctness execution");
      Check(aclrtMemcpy(output.data(),output.size(),y,output.size(),ACL_MEMCPY_DEVICE_TO_HOST),"download");
      if(!Verify(output,golden)) return 3;
      std::printf("PASS,pattern=%d,mode=%d\n",pattern,m);
    }
  }
  if(rounds) {
    for(int w=0;w<20;++w) for(int m=0;m<MODES;++m) Launch(m,blocks,stream,y+64,x,groups);
    Check(aclrtSynchronizeStream(stream),"warmup");
    for(int r=0;r<rounds;++r) for(int j=0;j<MODES;++j) {
      int m=(r+j)%MODES;
      Launch(m,blocks,stream,y+64,x,groups);
      Check(aclrtSynchronizeStream(stream),"timed execution");
      if(r==rounds-1) {
        Check(aclrtMemcpy(output.data(),output.size(),y,output.size(),ACL_MEMCPY_DEVICE_TO_HOST),"post-timing download");
        if(!Verify(output,golden)) return 3;
        std::printf("POST_CHECK,mode=%d,status=PASS\n",m);
      }
    }
  }
  aclrtFree(x); aclrtFree(y); return 0;
}
int main(int argc,char **argv) {
  std::setvbuf(stdout,nullptr,_IOLBF,0);
  if(argc<4) return 2;
  int rounds=std::atoi(argv[1]),device=std::atoi(argv[2]);
  if(rounds<0 || rounds>1000 || device<0 || device>1) return 2;
  Check(aclInit(nullptr),"init"); Check(aclrtSetDevice(device),"device");
  aclrtStream stream=nullptr; Check(aclrtCreateStream(&stream),"stream");
  int status=0;
  for(int i=3;i<argc && !status;++i) {
    uint32_t groups=0,blocks=0; char extra;
    if(std::sscanf(argv[i],"%u:%u%c",&groups,&blocks,&extra)!=2) return 2;
    status=Case(groups,blocks,rounds,stream);
  }
  aclrtDestroyStream(stream); aclrtResetDevice(device); aclFinalize(); return status;
}
