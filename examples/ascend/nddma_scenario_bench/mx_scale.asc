#include <algorithm>
#include <cstdint>
#include <cstdio>
#include <cstdlib>
#include <cstring>
#include <vector>
#include <type_traits>
#include "acl/acl.h"
#include "c_api/asc_simd.h"
#include "simt_api/asc_simt.h"
#ifndef TRANSPOSE
#define TRANSPOSE 0
#endif
#ifndef SOURCE_OFFSET
#define SOURCE_OFFSET 1
#endif
#ifndef SOURCE_ROWS
#define SOURCE_ROWS 17
#endif
#ifndef SOURCE_COLS
#define SOURCE_COLS 65
#endif
#ifndef TAKE_ROWS
#define TAKE_ROWS 4
#endif
#ifndef TAKE_COLS
#define TAKE_COLS 16
#endif
#ifndef TILE_GROUPS
#define TILE_GROUPS 32
#endif
constexpr uint32_t H=SOURCE_ROWS, W=SOURCE_COLS, R=TAKE_ROWS, C=TAKE_COLS;
constexpr uint32_t P=(R+1)/2, O=2*P*C, S=R*C, CP=(C+31)/32*32;
constexpr int MODES=4;
static_assert(R>=3 && ((R+1)&R)==0 && C>=8 && (C&(C-1))==0 && O>=128);
static_assert(O<=4096 && TILE_GROUPS>0 && SOURCE_OFFSET==0);
template<int M> constexpr uint32_t Pitch = M==0 ? O : M==1 ? 2*P*CP : S;
template<int M> constexpr uint32_t Capacity = 90000/(Pitch<M>+O);
template<int M> constexpr uint32_t Tile = Capacity<M><TILE_GROUPS ? Capacity<M> : TILE_GROUPS;
template<int M> constexpr uint32_t Plane = (Tile<M>*P*(M==1 ? CP : C)+255)/256*256;
__simd_vf__ void Zero(__ubuf__ uint8_t *out,uint32_t count) {
  vector_uint8_t z; asc_duplicate_scalar(z,uint8_t(0),asc_create_mask_b8(PAT_ALL));
  uint16_t n=(count+255)/256;
  for(uint16_t i=0;i<n;++i) asc_storealign(out+i*256,z,asc_update_mask_b8(count));
}
template<int M> __simd_vf__ void Convert(__ubuf__ uint8_t *out,__ubuf__ uint8_t *in,uint32_t groups) {
  if constexpr(M==0 || (M==1 && C==CP)) {
    vector_uint8_t a,b,lo,hi;
    uint32_t count=groups*O;
    for(uint16_t i=0;i<(groups*P*C+255)/256;++i) {
      asc_loadalign(a,in+i*256); asc_loadalign(b,in+Plane<M>+i*256);
      vintlv(reinterpret_cast<vector_int8_t &>(lo),reinterpret_cast<vector_int8_t &>(hi),
             reinterpret_cast<vector_int8_t &>(a),reinterpret_cast<vector_int8_t &>(b));
      asc_storealign(out+i*512,lo,asc_update_mask_b8(count));
      if(count) asc_storealign(out+i*512+256,hi,asc_update_mask_b8(count));
    }
  } else if constexpr(M==1) {
    vector_uint16_t lane,row,col,idx,a,b,mc;
    auto all=asc_create_mask_b16(PAT_ALL);
    asc_arange(reinterpret_cast<vector_int16_t &>(lane),0); asc_duplicate_scalar(mc,uint16_t(C-1),all);
    asc_and(col,lane,mc,all); asc_shiftright_scalar(row,lane,__builtin_ctz(C),all);
    asc_mul_scalar(row,row,uint16_t(CP),all); asc_add(idx,row,col,all);
    uint32_t count=groups*P*C;
    for(uint16_t i=0;i<(groups*P*C+127)/128;++i) {
      auto mask=asc_update_mask_b16(count);
      asc_gather(a,in+i*128/C*CP,idx,mask); asc_gather(b,in+Plane<M>+i*128/C*CP,idx,mask);
      asc_shiftleft_scalar(b,b,8,mask); asc_or(a,a,b,mask);
      asc_storealign(reinterpret_cast<__ubuf__ uint16_t *>(out)+i*128,a,mask);
    }
  } else {
    vector_uint16_t lane,row,col,pair,idx,t,one,mc,zero,a;
    auto all=asc_create_mask_b16(PAT_ALL);
    asc_arange(reinterpret_cast<vector_int16_t &>(lane),0);
    asc_duplicate_scalar(one,uint16_t(1),all); asc_duplicate_scalar(mc,uint16_t(C-1),all);
    asc_duplicate_scalar(zero,uint16_t(0),all);
    for(uint16_t j=0;j<O/128;++j) {
      asc_add_scalar(t,lane,uint16_t(j*128),all);
      asc_and(row,t,one,all); asc_shiftright_scalar(pair,t,__builtin_ctz(C)+1,all);
      asc_mul_scalar(pair,pair,uint16_t(2),all); asc_add(row,row,pair,all);
      asc_shiftright_scalar(col,t,1,all); asc_and(col,col,mc,all);
      vector_bool valid; asc_le_scalar(valid,row,uint16_t(R-1),all);
      asc_mul_scalar(row,row,uint16_t(C),all); asc_add(idx,row,col,all); asc_select(idx,idx,zero,valid);
      for(uint16_t g=0;g<groups;++g) {
        asc_gather(a,in+g*S,idx,all); asc_select(a,a,zero,valid);
        asc_storealign_pack(reinterpret_cast<__ubuf__ uint16_t *>(out+g*O+j*128),a,all);
      }
    }
  }
}
template<int M> __aicore__ inline void CopyIn(__ubuf__ uint8_t *in,__gm__ uint8_t *x,uint32_t groups) {
  if constexpr(M==0) {
    asc_ndim_pad_count_config pad{}; asc_set_ndim_pad_count(pad);
    asc_ndim_copy_gm2ub(reinterpret_cast<__ubuf__ fp8_e8m0_t *>(in),reinterpret_cast<__gm__ fp8_e8m0_t *>(x),
        C,P,groups,1,1,0,0,true,asc_load_l2_cache_mode::NORMAL_FIRST_VICTIM);
    pad.loop1_rp_count=1; asc_set_ndim_pad_count(pad);
    asc_ndim_copy_gm2ub(reinterpret_cast<__ubuf__ fp8_e8m0_t *>(in+Plane<M>),reinterpret_cast<__gm__ fp8_e8m0_t *>(x+C),
        C,P-1,groups,1,1,0,0,true,asc_load_l2_cache_mode::NORMAL_FIRST_VICTIM);
  } else if constexpr(M==1) {
    constexpr uint32_t L=(S%32==0 ? 1 : S%16==0 ? 2 : 4);
    for(uint32_t p=0;p<L && p<groups;++p) {
      uint32_t n=(groups-1-p)/L+1;
      asc_set_gm2ub_loop_size(n,1); asc_set_gm2ub_loop1_stride(L*S,L*P*CP);
      asc_copy_gm2ub_align(in+p*P*CP,x+p*S,P,C,0,0,false,0,2*C,CP);
      asc_copy_gm2ub_align(in+Plane<M>+p*P*CP,x+p*S+C,P-1,C,0,0,false,0,2*C,CP);
    }
    asc_set_gm2ub_loop_size(1,1);
  } else asc_copy_gm2ub_align(in,x,groups*S);
}
template<int M> __aicore__ inline void Run(__gm__ uint8_t *out,__gm__ uint8_t *x,uint32_t groups) {
  asc_init(); constexpr uint32_t T=Tile<M>, I=M==2 ? (T*S+255)/256*256 : 2*Plane<M>, U=(T*O+511)/512*512;
  __ubuf__ uint8_t input[2*I]; __ubuf__ uint8_t output[2*U];
  uint32_t bid=block_idx,blocks=block_num,tasks=(groups+T-1)/T;
  if(bid>=tasks) return;
  uint32_t local=(tasks-1-bid)/blocks+1;
  asc_set_gm2ub_loop_size(1,1);
  if constexpr(M==0) {
    asc_set_ndim_loop0_stride(1,1); asc_set_ndim_loop1_stride(C,2*C); asc_set_ndim_loop2_stride(P*C,S);
    asc_set_ndim_loop3_stride(0,0); asc_set_ndim_loop4_stride(0,0); asc_set_ndim_pad_value(uint8_t(0)); asc_ndim_copy_dci();
  } else if constexpr(M==1) {
    asc_vf_call<Zero>(input,2*I);
    asc_sync_notify(PIPE_V,PIPE_MTE2,EVENT_ID2); asc_sync_wait(PIPE_V,PIPE_MTE2,EVENT_ID2);
  }
  uint32_t offset=bid*T,count=groups-offset<T ? groups-offset : T;
  CopyIn<M>(input,x+offset*S,count); asc_sync_notify(PIPE_MTE2,PIPE_V,EVENT_ID0);
  for(uint32_t i=0;i<local;++i) {
    uint32_t slot=i%2; event_t event=slot==0 ? EVENT_ID0 : EVENT_ID1;
    if(i+1<local) {
      uint32_t ns=(i+1)%2; event_t ne=ns==0 ? EVENT_ID0 : EVENT_ID1;
      if(i+1>=2) asc_sync_wait(PIPE_V,PIPE_MTE2,ne);
      uint32_t no=(bid+(i+1)*blocks)*T,nc=groups-no<T ? groups-no : T;
      CopyIn<M>(input+ns*I,x+no*S,nc); asc_sync_notify(PIPE_MTE2,PIPE_V,ne);
    }
    asc_sync_wait(PIPE_MTE2,PIPE_V,event); if(i>=2) asc_sync_wait(PIPE_MTE3,PIPE_V,event);
    offset=(bid+i*blocks)*T; count=groups-offset<T ? groups-offset : T;
    asc_vf_call<Convert<M>>(output+slot*U,input+slot*I,count);
    if(i+2<local) asc_sync_notify(PIPE_V,PIPE_MTE2,event);
    asc_sync_notify(PIPE_V,PIPE_MTE3,event); asc_sync_wait(PIPE_V,PIPE_MTE3,event);
    asc_copy_ub2gm_align(out+offset*O,output+slot*U,count*O);
    if(i+2<local) asc_sync_notify(PIPE_MTE3,PIPE_V,event);
  }
  asc_sync_pipe(PIPE_ALL);
}
#define KERNEL(Name,Mode) \
__global__ __vector__ void Name(__gm__ uint8_t *out,__gm__ uint8_t *x,uint32_t groups) { Run<Mode>(out,x,groups); }
KERNEL(MxNddma,0)
KERNEL(MxDmaPlanes,1)
KERNEL(MxDmaFull,2)
__simt_vf__ __launch_bounds__(512) inline void SimtMx(__gm__ uint8_t *out,__gm__ uint8_t *x,uint32_t n,uint32_t bid,uint32_t blocks) {
  for(uint32_t i=bid*blockDim.x+threadIdx.x;i<n;i+=blocks*blockDim.x) {
    uint32_t g=i/O,q=i%O,r=(q/(2*C))*2+q%2,c=(q/2)%C;
    out[i]=r<R ? x[g*S+r*C+c] : 0;
  }
}
__global__ __vector__ void MxSimt(__gm__ uint8_t *out,__gm__ uint8_t *x,uint32_t groups) {
  asc_vf_call<SimtMx>(dim3(512),out,x,groups*O,uint32_t(block_idx),uint32_t(block_num));
}
void Launch(int mode,uint32_t blocks,aclrtStream stream,uint8_t *out,uint8_t *x,uint32_t groups) {
  if(mode==0) MxNddma<<<blocks,0,stream>>>(out,x,groups);
  if(mode==1) MxDmaPlanes<<<blocks,0,stream>>>(out,x,groups);
  if(mode==2) MxDmaFull<<<blocks,0,stream>>>(out,x,groups);
  if(mode==3) MxSimt<<<blocks,0,stream>>>(out,x,groups);
}
void Check(aclError code,const char *what) {
  if(code!=ACL_SUCCESS) { std::fprintf(stderr,"ACL_FAILURE %s %d\n",what,(int)code); std::exit(2); }
}
bool Verify(const std::vector<uint8_t>& out,const std::vector<uint8_t>& ref) {
  for(size_t i=0;i<out.size();++i) {
    uint8_t expected=i>=64 && i<ref.size()+64 ? ref[i-64] : uint8_t(0xa5);
    if(out[i]!=expected) { std::fprintf(stderr,"MISMATCH i=%zu got=%u expected=%u\n",i,out[i],expected); return false; }
  }
  return true;
}
int Case(uint32_t groups,uint32_t blocks,int rounds,aclrtStream stream) {
  if(!groups || groups>65536 || !blocks || blocks>64 || uint64_t(groups)*S>512*1024*1024) return 2;
  std::vector<uint8_t> input(groups*S+64), golden(groups*O), output(groups*O+128,uint8_t(0xa5));
  uint8_t *x=nullptr,*y=nullptr;
  Check(aclrtMalloc((void**)&x,input.size(),ACL_MEM_MALLOC_HUGE_FIRST),"input");
  Check(aclrtMalloc((void**)&y,output.size(),ACL_MEM_MALLOC_HUGE_FIRST),"output");
  std::printf("CONFIG,groups=%u,blocks=%u,rounds=%d,H=%u,W=%u,R=%u,C=%u,tiles=%u:%u:%u:%u:%u:%u\n",groups,blocks,rounds,H,W,R,C,Tile<0>,Tile<1>,Tile<2>,Tile<3>,Tile<4>,Tile<5>);
  for(int pattern=0;pattern<3;++pattern) {
    uint32_t rng=12345+pattern;
    for(auto &v:input) { rng=rng*1664525u+1013904223u; v=static_cast<uint8_t>(rng>>16); }
    for(uint32_t g=0;g<groups;++g) for(uint32_t pair=0;pair<P;++pair)
      for(uint32_t c=0;c<C;++c) for(uint32_t k=0;k<2;++k)
        golden[g*O+pair*2*C+2*c+k]=(2*pair+k<R) ? input[g*S+(2*pair+k)*C+c] : 0;
    Check(aclrtMemcpy(x,input.size(),input.data(),input.size(),ACL_MEMCPY_HOST_TO_DEVICE),"upload");
    for(int m=0;m<MODES;++m) {
      std::fill(output.begin(),output.end(),uint8_t(0xa5));
      Check(aclrtMemcpy(y,output.size(),output.data(),output.size(),ACL_MEMCPY_HOST_TO_DEVICE),"poison");
      Launch(m,blocks,stream,y+64,x,groups);
      Check(aclrtSynchronizeStream(stream),"correctness execution");
      Check(aclrtMemcpy(output.data(),output.size(),y,output.size(),ACL_MEMCPY_DEVICE_TO_HOST),"download");
      if(!Verify(output,golden)) return 3;
      std::printf("PASS,pattern=%d,mode=%d\n",pattern,m);
    }
  }
  if(rounds) {
    for(int w=0;w<20;++w) for(int m=0;m<MODES;++m) Launch(m,blocks,stream,y+64,x,groups);
    Check(aclrtSynchronizeStream(stream),"warmup");
    for(int r=0;r<rounds;++r) for(int j=0;j<MODES;++j) {
      int m=(r+j)%MODES;
      Launch(m,blocks,stream,y+64,x,groups);
      Check(aclrtSynchronizeStream(stream),"timed execution");
      if(r==rounds-1) {
        Check(aclrtMemcpy(output.data(),output.size(),y,output.size(),ACL_MEMCPY_DEVICE_TO_HOST),"post-timing download");
        if(!Verify(output,golden)) return 3;
        std::printf("POST_CHECK,mode=%d,status=PASS\n",m);
      }
    }
  }
  aclrtFree(x); aclrtFree(y); return 0;
}
int main(int argc,char **argv) {
  std::setvbuf(stdout,nullptr,_IOLBF,0);
  if(argc<4) return 2;
  int rounds=std::atoi(argv[1]),device=std::atoi(argv[2]);
  if(rounds<0 || rounds>1000 || device<0 || device>1) return 2;
  Check(aclInit(nullptr),"init"); Check(aclrtSetDevice(device),"device");
  aclrtStream stream=nullptr; Check(aclrtCreateStream(&stream),"stream");
  int status=0;
  for(int i=3;i<argc && !status;++i) {
    uint32_t groups=0,blocks=0; char extra;
    if(std::sscanf(argv[i],"%u:%u%c",&groups,&blocks,&extra)!=2) return 2;
    status=Case(groups,blocks,rounds,stream);
  }
  aclrtDestroyStream(stream); aclrtResetDevice(device); aclFinalize(); return status;
}
