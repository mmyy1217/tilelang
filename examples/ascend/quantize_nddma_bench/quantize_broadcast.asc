#include <algorithm>
#include <cmath>
#include <cstdint>
#include <cstdio>
#include <cstdlib>
#include <limits>
#include <vector>
#include "acl/acl.h"
#include "c_api/asc_simd.h"

#ifndef CHANNELS
#define CHANNELS 16
#endif
#ifndef TILE_ELEMENTS
#define TILE_ELEMENTS 4096
#endif
constexpr uint32_t C = CHANNELS;
constexpr uint32_t TILE = TILE_ELEMENTS;
static_assert(C == 8 || C == 16, "Benchmark supports C=8 or C=16 only");
static_assert(TILE % 64 == 0 && TILE <= 8192);

__simd_callee__ inline void LoadRepeatedScale(vector_float &s, __ubuf__ float *raw) {
  vector_int32_t lane, bits;
  auto mask = asc_create_mask_b32(PAT_ALL);
  asc_arange(lane, 0);
  asc_duplicate_scalar(bits, static_cast<int32_t>(C - 1), mask);
  asc_and(lane, lane, bits, mask);
  // Gather indices count elements, not bytes.
  asc_gather(s, raw, reinterpret_cast<vector_uint32_t &>(lane), mask);
}

__simd_vf__ void ExpandScale(__ubuf__ float *expanded, __ubuf__ float *raw) {
  vector_float s;
  LoadRepeatedScale(s, raw);
  auto mask = asc_create_mask_b32(PAT_ALL);
  for (uint16_t i = 0; i < TILE / 64; ++i)
    asc_storealign(expanded + i * 64, s, mask);
}

template <int Mode>
__simd_vf__ void QuantizeVF(__ubuf__ uint8_t *out, __ubuf__ float *x,
                           __ubuf__ float *scale, uint32_t count) {
  vector_float s, a, value;
  vector_fp8_e4m3fn_t q;
  if constexpr (Mode == 2)
    LoadRepeatedScale(s, scale);
  if constexpr (Mode == 3)
    asc_loadalign(s, scale);
  uint16_t repeats = (count + 63) / 64;
  for (uint16_t i = 0; i < repeats; ++i) {
    auto mask = asc_update_mask_b32(count);
    asc_loadalign(a, x + i * 64);
    if constexpr (Mode < 2)
      asc_loadalign(s, scale + i * 64);
    asc_mul(value, a, s, mask);
    asc_float2e4m3_rn_sat(q, value, mask, ASC_DISPERSE_FIRST_QUARTER);
    asc_storealign_pack_quarter(reinterpret_cast<__ubuf__ uint32_t *>(out + i * 64),
                           reinterpret_cast<vector_uint32_t &>(q), mask);
  }
}

template <int Mode>
__aicore__ inline void Quantize(__gm__ uint8_t *out, __gm__ float *x,
                               __gm__ float *scale, uint32_t elements) {
  asc_init();
  const uint32_t tasks = (elements + TILE - 1) / TILE;
  const uint32_t bid = static_cast<uint32_t>(block_idx);
  const uint32_t blocks = static_cast<uint32_t>(block_num);
  if (bid >= tasks)
    return;
  // Match QuantizeBase::SetFloatOverflowModeForRegbase for FP8 output.
  const uint64_t original_ctrl = asc_get_ctrl();
  asc_set_ctrl(original_ctrl & ~(uint64_t{1} << 60));
  const uint32_t local_tasks = (tasks - 1 - bid) / blocks + 1;
  __ubuf__ float input[2 * TILE];
  __ubuf__ uint8_t output[2 * TILE];
  __ubuf__ float scales[Mode < 2 ? TILE : 64];
  __ubuf__ float raw[64];
  asc_set_gm2ub_loop_size(1, 1);
  if constexpr (Mode == 0 || Mode == 3) {
    asc_set_ndim_loop0_stride(1, 1);
    asc_set_ndim_loop1_stride(C, 0);
    asc_set_ndim_loop2_stride(0, 0);
    asc_set_ndim_loop3_stride(0, 0);
    asc_set_ndim_loop4_stride(0, 0);
    asc_ndim_pad_count_config pad{};
    asc_set_ndim_pad_count(pad);
    asc_ndim_copy_dci();
    asc_ndim_copy_gm2ub(scales, scale, C, (Mode == 0 ? TILE : 64) / C,
                       1, 1, 1, 0, 0, false,
                       asc_load_l2_cache_mode::NORMAL_FIRST_VICTIM);
  } else {
    asc_copy_gm2ub_align(Mode == 1 ? raw : scales, scale, C * sizeof(float));
  }
  asc_sync_notify(PIPE_MTE2, PIPE_V, EVENT_ID3);
  asc_sync_wait(PIPE_MTE2, PIPE_V, EVENT_ID3);
  if constexpr (Mode == 1) {
    asc_vf_call<ExpandScale>(scales, raw);
    asc_sync_pipe(PIPE_V);
  }
  uint32_t offset = bid * TILE;
  uint32_t count = elements - offset < TILE ? elements - offset : TILE;
  asc_copy_gm2ub_align(input, x + offset, count * sizeof(float));
  asc_sync_notify(PIPE_MTE2, PIPE_V, EVENT_ID0);
  for (uint32_t i = 0; i < local_tasks; ++i) {
    uint32_t slot = i % 2;
    event_t event = slot == 0 ? EVENT_ID0 : EVENT_ID1;
    if (i + 1 < local_tasks) {
      uint32_t next_slot = (i + 1) % 2;
      event_t next_event = next_slot == 0 ? EVENT_ID0 : EVENT_ID1;
      if (i + 1 >= 2)
        asc_sync_wait(PIPE_V, PIPE_MTE2, next_event);
      uint32_t next_offset = (bid + (i + 1) * blocks) * TILE;
      uint32_t next_count = elements - next_offset < TILE ? elements - next_offset : TILE;
      asc_copy_gm2ub_align(input + next_slot * TILE, x + next_offset,
                           next_count * sizeof(float));
      asc_sync_notify(PIPE_MTE2, PIPE_V, next_event);
    }
    asc_sync_wait(PIPE_MTE2, PIPE_V, event);
    if (i >= 2)
      asc_sync_wait(PIPE_MTE3, PIPE_V, event);
    offset = (bid + i * blocks) * TILE;
    count = elements - offset < TILE ? elements - offset : TILE;
    asc_vf_call<QuantizeVF<Mode>>(output + slot * TILE, input + slot * TILE, scales, count);
    if (i + 2 < local_tasks)
      asc_sync_notify(PIPE_V, PIPE_MTE2, event);
    asc_sync_notify(PIPE_V, PIPE_MTE3, event);
    asc_sync_wait(PIPE_V, PIPE_MTE3, event);
    asc_copy_ub2gm_align(out + offset, output + slot * TILE, count);
    if (i + 2 < local_tasks)
      asc_sync_notify(PIPE_MTE3, PIPE_V, event);
  }
  asc_sync_pipe(PIPE_ALL);
  asc_set_ctrl(original_ctrl);
}

#define DEFINE_KERNEL(Name, Mode) \
__global__ __vector__ void Name(__gm__ uint8_t *out, __gm__ float *x, \
                                __gm__ float *scale, uint32_t elements) { \
  Quantize<Mode>(out, x, scale, elements); \
}
DEFINE_KERNEL(QuantNddmaTile, 0)
DEFINE_KERNEL(QuantUbBroadcast, 1)
DEFINE_KERNEL(QuantRegisterReuse, 2)
DEFINE_KERNEL(QuantNddmaRegister, 3)

void Launch(int mode, uint32_t blocks, aclrtStream stream, uint8_t *out,
            float *x, float *scale, uint32_t elements) {
  if (mode == 0) QuantNddmaTile<<<blocks, 0, stream>>>(out, x, scale, elements);
  if (mode == 1) QuantUbBroadcast<<<blocks, 0, stream>>>(out, x, scale, elements);
  if (mode == 2) QuantRegisterReuse<<<blocks, 0, stream>>>(out, x, scale, elements);
  if (mode == 3) QuantNddmaRegister<<<blocks, 0, stream>>>(out, x, scale, elements);
}

float Decode(uint8_t code) {
  uint8_t magnitude = code & 127;
  if (magnitude == 127) return std::numeric_limits<float>::quiet_NaN();
  int exponent = magnitude >> 3;
  int mantissa = magnitude & 7;
  float result = exponent == 0 ? std::ldexp(static_cast<float>(mantissa), -9)
                               : std::ldexp(1.0f + mantissa / 8.0f, exponent - 7);
  return code & 128 ? -result : result;
}

uint8_t Encode(float value) {
  uint8_t sign = std::signbit(value) ? 128 : 0;
  if (std::isnan(value)) return 127;
  float magnitude = std::fabs(value);
  if (magnitude >= 448.0f) return sign | 126;
  static const std::vector<float> values = [] {
    std::vector<float> v(127);
    for (int i = 0; i <= 126; ++i) v[i] = Decode(i);
    return v;
  }();
  auto upper = std::lower_bound(values.begin(), values.end(), magnitude);
  uint8_t best = static_cast<uint8_t>(upper - values.begin());
  if (best > 0) {
    float lower_distance = magnitude - values[best - 1];
    float upper_distance = values[best] - magnitude;
    if (lower_distance < upper_distance ||
        (lower_distance == upper_distance && (best & 1))) --best;
  }
  return sign | best;
}

void Check(aclError code, const char *what) {
  if (code != ACL_SUCCESS) {
    std::fprintf(stderr, "ACL_FAILURE %s %d\n", what, static_cast<int>(code));
    std::exit(2);
  }
}

int main(int argc, char **argv) {
  std::setvbuf(stdout, nullptr, _IOLBF, 0);
  uint32_t rows = argc > 1 ? std::strtoul(argv[1], nullptr, 10) : 4096;
  uint32_t blocks = argc > 2 ? std::strtoul(argv[2], nullptr, 10) : 32;
  int rounds = argc > 3 ? std::atoi(argv[3]) : 0;
  int device = argc > 4 ? std::atoi(argv[4]) : 0;
  if (rows == 0 || rows > 1048576 || blocks == 0 || blocks > 64 ||
      rounds < 0 || rounds > 1000 || device < 0 || device > 1) return 2;
  uint32_t elements = rows * C;
  constexpr uint32_t GUARD = 256;
  std::vector<float> input(elements + 64), scale(64, 0);
  std::vector<uint8_t> golden(elements), output(elements + 2 * GUARD, 165);
  Check(aclInit(nullptr), "init");
  Check(aclrtSetDevice(device), "device");
  aclrtStream stream = nullptr;
  Check(aclrtCreateStream(&stream), "stream");
  float *dx = nullptr, *ds = nullptr;
  uint8_t *dy = nullptr;
  Check(aclrtMalloc(reinterpret_cast<void **>(&dx), input.size() * 4, ACL_MEM_MALLOC_HUGE_FIRST), "input allocation");
  Check(aclrtMalloc(reinterpret_cast<void **>(&ds), scale.size() * 4, ACL_MEM_MALLOC_HUGE_FIRST), "scale allocation");
  Check(aclrtMalloc(reinterpret_cast<void **>(&dy), output.size(), ACL_MEM_MALLOC_HUGE_FIRST), "output allocation");
  bool correct = true;
  for (int pattern = 0; pattern < 3; ++pattern) {
    uint32_t rng = 12345 + pattern;
    for (uint32_t c = 0; c < C; ++c)
      scale[c] = pattern == 1 ? 1.0f : 0.125f + static_cast<float>((c * 13 + pattern * 7) % 31) / 16.0f;
    for (uint32_t i = 0; i < elements; ++i) {
      rng = rng * 1664525u + 1013904223u;
      input[i] = static_cast<int32_t>(rng % 16001) / 16.0f - 500.0f;
      if (pattern == 1) {
        uint32_t j = (i / 4) % 126;
        float mid = (Decode(j) + Decode(j + 1)) / 2;
        float v = i % 4 == 0 ? mid : i % 4 == 1 ? std::nextafter(mid, 0.0f)
                                  : i % 4 == 2 ? std::nextafter(mid, 1000.0f) : Decode(j);
        input[i] = i & 512 ? -v : v;
      }
      if (pattern == 2 && i % 37 == 0) input[i] = -0.0f;
      golden[i] = Encode(input[i] * scale[i % C]);
    }
    Check(aclrtMemcpy(dx, input.size() * 4, input.data(), input.size() * 4, ACL_MEMCPY_HOST_TO_DEVICE), "input upload");
    Check(aclrtMemcpy(ds, scale.size() * 4, scale.data(), scale.size() * 4, ACL_MEMCPY_HOST_TO_DEVICE), "scale upload");
    for (int mode = 0; mode < 4; ++mode) {
      std::fill(output.begin(), output.end(), 165);
      Check(aclrtMemcpy(dy, output.size(), output.data(), output.size(), ACL_MEMCPY_HOST_TO_DEVICE), "poison");
      Launch(mode, blocks, stream, dy + GUARD, dx, ds, elements);
      Check(aclrtSynchronizeStream(stream), "correctness execution");
      Check(aclrtMemcpy(output.data(), output.size(), dy, output.size(), ACL_MEMCPY_DEVICE_TO_HOST), "read output");
      bool mode_correct = true;
      for (uint32_t i = 0; i < output.size(); ++i) {
        uint8_t expected = i >= GUARD && i < GUARD + elements ? golden[i - GUARD] : 165;
        if (output[i] != expected) {
          std::fprintf(stderr, "MISMATCH pattern=%d mode=%d index=%u got=%u expected=%u\n", pattern, mode, i, output[i], expected);
          if (i >= GUARD && i < GUARD + elements)
            std::fprintf(stderr, "DETAIL input=%g scale=%g product=%g\n", input[i-GUARD], scale[(i-GUARD)%C], input[i-GUARD]*scale[(i-GUARD)%C]);
          mode_correct = false;
          correct = false;
          break;
        }
      }
      std::printf("%s,pattern=%d,mode=%d,elements=%u,guards=512\n", mode_correct ? "PASS" : "FAIL", pattern, mode, elements);
    }
  }
  std::printf("CONFIG,rows=%u,channels=%u,tile=%u,blocks=%u,device=%d,rounds=%d\n", rows, C, TILE, blocks, device, rounds);
  if (rounds && correct) {
    for (int w = 0; w < 20; ++w)
      for (int mode = 0; mode < 4; ++mode) Launch(mode, blocks, stream, dy + GUARD, dx, ds, elements);
    Check(aclrtSynchronizeStream(stream), "warmup");
    aclrtEvent start, stop;
    Check(aclrtCreateEvent(&start), "start event");
    Check(aclrtCreateEvent(&stop), "stop event");
    for (int r = 0; r < rounds; ++r) {
      for (int j = 0; j < 4; ++j) {
        int mode = (r + j) % 4;
        Check(aclrtRecordEvent(start, stream), "start record");
        Launch(mode, blocks, stream, dy + GUARD, dx, ds, elements);
        Check(aclrtRecordEvent(stop, stream), "stop record");
        Check(aclrtSynchronizeStream(stream), "timed execution");
        float ms;
        Check(aclrtEventElapsedTime(&ms, start, stop), "elapsed time");
        std::printf("SAMPLE,%d,%d,%.6f\n", r, mode, ms * 1000);
        if (r == rounds - 1) {
          Check(aclrtMemcpy(output.data(), output.size(), dy, output.size(), ACL_MEMCPY_DEVICE_TO_HOST), "post-timing read");
          for (uint32_t i = 0; i < output.size(); ++i) {
            uint8_t expected = i >= GUARD && i < GUARD + elements ? golden[i - GUARD] : 165;
            if (output[i] != expected) {
              std::fprintf(stderr, "POST_TIMING_MISMATCH mode=%d index=%u\n", mode, i);
              correct = false;
              break;
            }
          }
          std::printf("POST_CHECK,mode=%d,status=%s\n", mode, correct ? "PASS" : "FAIL");
        }
      }
    }
    aclrtDestroyEvent(start);
    aclrtDestroyEvent(stop);
  }
  aclrtFree(dx); aclrtFree(ds); aclrtFree(dy);
  aclrtDestroyStream(stream); aclrtResetDevice(device); aclFinalize();
  return correct ? 0 : 3;
}
