# from tvm.script import tirx as T

@T.prim_func
def main(src_handle: T.handle, dst_handle: T.handle):
    src = T.match_buffer(src_handle, (8, 256), strides=(256, 1))
    dst = T.match_buffer(dst_handle, (8, 256), strides=(256, 1))
    # with T.sblock("root"):
    for bx in T.thread_binding(1, thread="blockIdx.x"):
        tx: T.int32 = T.launch_thread_idx(0)
        ty: T.int32 = T.launch_thread_idx(1)
        tz: T.int32 = T.launch_thread_idx(2)
        with T.sblock("tilelang_root"):
            T.reads()
            T.writes()
            ub = T.handle("float32", "shared.dyn")
            T.sblock_attr({"tl.buffer_versions_map": {ub: 1}})
            ub_1 = T.sblock_alloc_buffer((256,), data=ub, scope="shared.dyn")
            for i in T.serial(8, annotations={"num_stages": 1}):
                T.ascend_copy(T.region(src[i, 0], 1, 1, 256), T.region(ub_1[0], 2, 256))
                T.ascend_copy(T.region(ub_1[0], 1, 256), T.region(dst[i, 0], 2, 1, 256))
