# from tvm.script import ir as I
# from tvm.script import tirx as T

@I.ir_module
class Module:
    @T.prim_func
    def main_kernel(dst: T.handle("float32", "global"), src: T.handle("float32", "global"), n: T.int32):
        T.func_attr({"calling_conv": 2, "dyn_shared_memory_buf": 256, "target": T.target({"keys": ["ascend"], "kind": "ascend", "launch_grid_only": True, "max_vector_bits": 64, "supports_kernel_status_return": False, "supports_vector_predicate": True, "tag": ""}), "thread_extent": {"blockIdx.x": (n + 63) // 64}, "tirx.is_global_func": T.bool(True), "tirx.kernel_launch_params": ["blockIdx.x", "tirx.use_dyn_shared_memory"], "tirx.noalias": True, "tl.non_restrict_params": [], "tl.readonly_param_indices": [1]})
        T.attr(T.bool(True), "tl.assume", "Buffer shape should be greater than or equal to 0: shape `n` from buffer `src`, `dst`")
        bx = T.launch_thread("blockIdx.x", (n + 63) // 64)
        ub = T.alloc_buffer((64,), scope="shared.dyn")
        ub_1 = T.decl_buffer((64,), data=ub.data, scope="shared.dyn")
        with T.sblock("VECTOR", no_realize=True):
            T.reads()
            T.writes()
            T.ascend_copy_gm_to_ubuf(T.tvm_access_ptr(T.type_annotation("float32"), ub.data, 0, T.min(64, T.max(n - bx * 64, 0)), 2), T.tvm_access_ptr(T.type_annotation("float32"), src, T.Cast("int64", bx) * T.int64(64), T.min(64, T.max(n - bx * 64, 0)), 1), 0, 1, T.min(64, T.max(n - bx * 64, 0)) * 4, 0, 0, 0, 0, T.min(64, T.max(n - bx * 64, 0)) * 4, T.min(64, T.max(n - bx * 64, 0)) * 4)
            T.ascend_set_flag("MTE2_MTE3", 0)
            T.ascend_wait_flag("MTE2_MTE3", 0)
            T.ascend_copy_ubuf_to_gm(T.tvm_access_ptr(T.type_annotation("float32"), dst, T.Cast("int64", bx) * T.int64(64), T.min(64, T.max(n - bx * 64, 0)), 2), T.tvm_access_ptr(T.type_annotation("float32"), ub.data, 0, T.min(64, T.max(n - bx * 64, 0)), 1), 0, 1, T.min(64, T.max(n - bx * 64, 0)) * 4, 4, T.min(64, T.max(n - bx * 64, 0)) * 4, T.min(64, T.max(n - bx * 64, 0)) * 4)
