# from tvm.script import tirx as T

@T.prim_func
def main(src_handle: T.handle):
    src = T.match_buffer(src_handle, (2, 3, 4), "bfloat16", strides=(20, 5, 1))
    # with T.sblock("root"):
    for bx in T.thread_binding(1, thread="blockIdx.x"):
        tx: T.int32 = T.launch_thread_idx(0)
        ty: T.int32 = T.launch_thread_idx(1)
        tz: T.int32 = T.launch_thread_idx(2)
        with T.sblock("tilelang_root"):
            T.reads()
            T.writes()
            ub = T.sblock_alloc_buffer((2, 3, 4), "bfloat16", scope="shared.dyn")
            T.ascend_copy(T.region(src[0, 0, 0], 1, 2, 3, 4), T.region(ub[0, 0, 0], 2, 2, 3, 4))
