            T.writes()
            ub = T.sblock_alloc_buffer((32, 64), scope="shared.dyn")
            l1 = T.sblock_alloc_buffer((64, 64), scope="shared.l1")
            T.ascend_copy(T.region(src[0, 0], 1, 32, 64), T.region(ub[0, 0], 2, 32, 64))
