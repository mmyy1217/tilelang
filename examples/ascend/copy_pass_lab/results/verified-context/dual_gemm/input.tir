# from tvm.script import tirx as T

@T.prim_func
def main(a_handle: T.handle, b_handle: T.handle, c_handle: T.handle):
    a = T.match_buffer(a_handle, (32, 64), "bfloat16", strides=(64, 1))
    b = T.match_buffer(b_handle, (32, 64), "bfloat16", strides=(64, 1))
    c = T.match_buffer(c_handle, (32, 32), strides=(32, 1))
    # with T.sblock("root"):
    for bx in T.thread_binding(1, thread="blockIdx.x"):
        tx: T.int32 = T.launch_thread_idx(0)
        ty: T.int32 = T.launch_thread_idx(1)
        tz: T.int32 = T.launch_thread_idx(2)
        with T.sblock("tilelang_root"):
            T.reads()
            T.writes()
            acc = T.handle("float32", "shared.l0c")
            T.sblock_attr({"layout_map": {acc: metadata["tl.AscendFractalLayout"][0]}})
            a_l1 = T.sblock_alloc_buffer((32, 64), "bfloat16", scope="shared.l1")
            b_l1 = T.sblock_alloc_buffer((32, 64), "bfloat16", scope="shared.l1")
            acc_1 = T.sblock_alloc_buffer((32, 32), data=acc, scope="shared.l0c")
            ub = T.sblock_alloc_buffer((16, 32), scope="shared.dyn")
            T.ascend_copy(T.region(a[0, 0], 1, 32, 64), T.region(a_l1[0, 0], 2, 32, 64))
            T.ascend_copy(T.region(b[0, 0], 1, 32, 64), T.region(b_l1[0, 0], 2, 32, 64))
            T.gemm(T.region(a_l1[0, 0], 1, 32, 64), T.region(b_l1[0, 0], 1, 32, 64), T.region(acc_1[0, 0], 2, 32, 32), T.bool(False), T.bool(True), 32, 32, 64, 0, T.bool(True), 0, 0, 0)
            T.ascend_copy(T.region(acc_1[0, 0], 1, 32, 32), T.region(ub[0, 0], 2, 16, 32), dual_dst_ctl=1, l2_cache_ctrl=0)
            T.ascend_copy(T.region(ub[0, 0], 1, 16, 32), T.region(c[0, 0], 2, 32, 32), dual_dst_ctl=1, double=T.bool(True), l2_cache_ctrl=0)
