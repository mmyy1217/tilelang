# from tvm.script import ir as I
# from tvm.script import tirx as T

@I.ir_module
class Module:
    @T.prim_func
    def main(self_handle: T.handle, args: T.handle, num_args: T.int32, result: T.handle("void", "global")) -> T.int32:
        T.func_attr({"calling_conv": 1, "global_symbol": "__tvm_ffi_main", "target": T.target({"keys": ["cpu"], "kind": "c", "tag": ""}), "thread_extent": {}, "tirx.is_entry_func": True, "tl.has_tma": T.bool(False), "tl.readonly_param_indices": [0, 1, 2]})
        assert num_args == 3, ("RuntimeError", ["main: num_args should be 3"])
        assert not T.isnullptr(args), ("RuntimeError", ["main: args pointer is NULL"])
        a_handle_type_index: T.int32 = T.tvm_struct_get(args, 0, 13, "int32")
        assert a_handle_type_index == 0 or a_handle_type_index == 4 or a_handle_type_index == 7 or 64 <= a_handle_type_index, ("RuntimeError", ["kernel main input a expected pointer or tensor handle"])
        b_handle_type_index: T.int32 = T.tvm_struct_get(args, 1, 13, "int32")
        assert b_handle_type_index == 0 or b_handle_type_index == 4 or b_handle_type_index == 7 or 64 <= b_handle_type_index, ("RuntimeError", ["kernel main input b expected pointer or tensor handle"])
        c_handle_type_index: T.int32 = T.tvm_struct_get(args, 2, 13, "int32")
        assert c_handle_type_index == 0 or c_handle_type_index == 4 or c_handle_type_index == 7 or 64 <= c_handle_type_index, ("RuntimeError", ["kernel main input c expected pointer or tensor handle"])
        a_handle: T.handle = T.Select(a_handle_type_index == 70, T.handle_add_byte_offset(T.tvm_struct_get(args, 0, 15, "handle"), 24), T.tvm_struct_get(args, 0, 15, "handle"))
        b_handle: T.handle = T.Select(b_handle_type_index == 70, T.handle_add_byte_offset(T.tvm_struct_get(args, 1, 15, "handle"), 24), T.tvm_struct_get(args, 1, 15, "handle"))
        c_handle: T.handle = T.Select(c_handle_type_index == 70, T.handle_add_byte_offset(T.tvm_struct_get(args, 2, 15, "handle"), 24), T.tvm_struct_get(args, 2, 15, "handle"))
        main_a_is_null: T.bool = T.isnullptr(a_handle)
        assert not main_a_is_null, ("RuntimeError", ["main.a is expected to have non-NULL pointer"])
        main_b_is_null: T.bool = T.isnullptr(b_handle)
        assert not main_b_is_null, ("RuntimeError", ["main.b is expected to have non-NULL pointer"])
        main_c_is_null: T.bool = T.isnullptr(c_handle)
        assert not main_c_is_null, ("RuntimeError", ["main.c is expected to have non-NULL pointer"])
        main_a_shape: T.handle("int64", "global") = T.tvm_struct_get(a_handle, 0, 2, "handle")
        main_a_shape_1 = T.decl_buffer((2,), "int64", data=main_a_shape)
        main_b_shape: T.handle("int64", "global") = T.tvm_struct_get(b_handle, 0, 2, "handle")
        main_b_shape_1 = T.decl_buffer((2,), "int64", data=main_b_shape)
        main_c_shape: T.handle("int64", "global") = T.tvm_struct_get(c_handle, 0, 2, "handle")
        main_c_shape_1 = T.decl_buffer((2,), "int64", data=main_c_shape)
        assert T.tvm_struct_get(a_handle, 0, 4, "int32") == 2, ("RuntimeError", ["kernel main input a ndim mismatch, expected 2"])
        main_a_strides: T.handle("int64", "global") = T.tvm_struct_get(a_handle, 0, 3, "handle")
        main_a_strides_1 = T.decl_buffer((2,), "int64", data=main_a_strides)
        dev_id: T.int32 = T.tvm_struct_get(a_handle, 0, 9, "int32")
        a: T.handle("bfloat16", "global") = T.tvm_struct_get(a_handle, 0, 1, "handle")
        T.attr(a, "storage_alignment", 64)
        assert T.tvm_struct_get(b_handle, 0, 4, "int32") == 2, ("RuntimeError", ["kernel main input b ndim mismatch, expected 2"])
        main_b_strides: T.handle("int64", "global") = T.tvm_struct_get(b_handle, 0, 3, "handle")
        main_b_strides_1 = T.decl_buffer((2,), "int64", data=main_b_strides)
        b: T.handle("bfloat16", "global") = T.tvm_struct_get(b_handle, 0, 1, "handle")
        T.attr(b, "storage_alignment", 64)
        assert T.tvm_struct_get(c_handle, 0, 4, "int32") == 2, ("RuntimeError", ["kernel main input c ndim mismatch, expected 2"])
        main_c_strides: T.handle("int64", "global") = T.tvm_struct_get(c_handle, 0, 3, "handle")
        main_c_strides_1 = T.decl_buffer((2,), "int64", data=main_c_strides)
        c: T.handle("float32", "global") = T.tvm_struct_get(c_handle, 0, 1, "handle")
        T.attr(c, "storage_alignment", 64)
        T.attr("default", "device_id", dev_id)
        T.attr("default", "device_type", 12)
        assert T.tvm_struct_get(a_handle, 0, 5, "uint8") == T.uint8(4) and T.tvm_struct_get(a_handle, 0, 6, "uint8") == T.uint8(16) and T.tvm_struct_get(a_handle, 0, 7, "uint16") == T.uint16(1), ("RuntimeError", ["kernel main input a dtype mismatch, expected bfloat16"])
        assert T.Cast("int32", main_a_shape_1[0]) == 32, ("RuntimeError", ["kernel main input a shape[0] violates packed ABI constraint"])
        assert T.Cast("int32", main_a_shape_1[1]) == 64, ("RuntimeError", ["kernel main input a shape[1] violates packed ABI constraint"])
        assert T.if_then_else(T.isnullptr(main_a_strides), 1, T.Cast("int32", main_a_strides_1[1])) == 1, ("RuntimeError", ["kernel main input a strides[1] violates packed ABI constraint"])
        assert T.if_then_else(T.isnullptr(main_a_strides), 1, T.Cast("int32", main_a_strides_1[0])) == 64, ("RuntimeError", ["kernel main input a strides[0] violates packed ABI constraint"])
        assert T.uint64(0) == T.tvm_struct_get(a_handle, 0, 8, "uint64"), ("RuntimeError", ["kernel main input a byte_offset violates packed ABI constraint"])
        assert T.tvm_struct_get(a_handle, 0, 10, "int32") == 12, ("RuntimeError", ["kernel main input a device_type mismatch, expected ext_dev"])
        assert not T.isnullptr(a), ("RuntimeError", ["kernel main input a data pointer is NULL"])
        assert T.tvm_struct_get(b_handle, 0, 5, "uint8") == T.uint8(4) and T.tvm_struct_get(b_handle, 0, 6, "uint8") == T.uint8(16) and T.tvm_struct_get(b_handle, 0, 7, "uint16") == T.uint16(1), ("RuntimeError", ["kernel main input b dtype mismatch, expected bfloat16"])
        assert T.Cast("int32", main_b_shape_1[0]) == 32, ("RuntimeError", ["kernel main input b shape[0] violates packed ABI constraint"])
        assert T.Cast("int32", main_b_shape_1[1]) == 64, ("RuntimeError", ["kernel main input b shape[1] violates packed ABI constraint"])
        assert T.if_then_else(T.isnullptr(main_b_strides), 1, T.Cast("int32", main_b_strides_1[1])) == 1, ("RuntimeError", ["kernel main input b strides[1] violates packed ABI constraint"])
        assert T.if_then_else(T.isnullptr(main_b_strides), 1, T.Cast("int32", main_b_strides_1[0])) == 64, ("RuntimeError", ["kernel main input b strides[0] violates packed ABI constraint"])
        assert T.uint64(0) == T.tvm_struct_get(b_handle, 0, 8, "uint64"), ("RuntimeError", ["kernel main input b byte_offset violates packed ABI constraint"])
        assert T.tvm_struct_get(b_handle, 0, 9, "int32") == T.tvm_struct_get(a_handle, 0, 9, "int32"), ("RuntimeError", ["kernel main input b device_id violates packed ABI constraint"])
        assert T.tvm_struct_get(b_handle, 0, 10, "int32") == 12, ("RuntimeError", ["kernel main input b device_type mismatch, expected ext_dev"])
        assert not T.isnullptr(b), ("RuntimeError", ["kernel main input b data pointer is NULL"])
        assert T.tvm_struct_get(c_handle, 0, 5, "uint8") == T.uint8(2) and T.tvm_struct_get(c_handle, 0, 6, "uint8") == T.uint8(32) and T.tvm_struct_get(c_handle, 0, 7, "uint16") == T.uint16(1), ("RuntimeError", ["kernel main input c dtype mismatch, expected float32"])
        assert T.Cast("int32", main_c_shape_1[0]) == 32, ("RuntimeError", ["kernel main input c shape[0] violates packed ABI constraint"])
        assert T.Cast("int32", main_c_shape_1[1]) == 32, ("RuntimeError", ["kernel main input c shape[1] violates packed ABI constraint"])
        assert T.if_then_else(T.isnullptr(main_c_strides), 1, T.Cast("int32", main_c_strides_1[1])) == 1, ("RuntimeError", ["kernel main input c strides[1] violates packed ABI constraint"])
        assert T.if_then_else(T.isnullptr(main_c_strides), 1, T.Cast("int32", main_c_strides_1[0])) == 32, ("RuntimeError", ["kernel main input c strides[0] violates packed ABI constraint"])
        assert T.uint64(0) == T.tvm_struct_get(c_handle, 0, 8, "uint64"), ("RuntimeError", ["kernel main input c byte_offset violates packed ABI constraint"])
        assert T.tvm_struct_get(c_handle, 0, 9, "int32") == T.tvm_struct_get(a_handle, 0, 9, "int32"), ("RuntimeError", ["kernel main input c device_id violates packed ABI constraint"])
        assert T.tvm_struct_get(c_handle, 0, 10, "int32") == 12, ("RuntimeError", ["kernel main input c device_type mismatch, expected ext_dev"])
        assert not T.isnullptr(c), ("RuntimeError", ["kernel main input c data pointer is NULL"])
        a_1 = T.decl_buffer((32, 64), "bfloat16", data=a, strides=(64, 1))
        b_1 = T.decl_buffer((32, 64), "bfloat16", data=b, strides=(64, 1))
        c_1 = T.decl_buffer((32, 32), data=c, strides=(32, 1))
        T.call_packed("__tvm_set_device", 12, dev_id)
        with T.attr(0, "compute_scope", "main_compute_"):
            T.call_packed("main_kernel", a, b, c, 1, 2048)
        return 0
