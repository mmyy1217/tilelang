@I.ir_module
class Module:
    @T.prim_func
    def main_kernel(dst: T.handle("float32", "global"), src: T.handle("float32", "global")):
        T.func_attr({"calling_conv": 2, "target": T.target({"keys": ["ascend"], "kind": "ascend", "launch_grid_only": True, "max_vector_bits": 64, "supports_kernel_status_return": False, "supports_vector_predicate": True, "tag": ""}), "thread_extent": {"blockIdx.x": 1}, "tirx.is_global_func": T.bool(True), "tirx.kernel_launch_params": ["blockIdx.x"], "tirx.noalias": True, "tl.non_restrict_params": [], "tl.readonly_param_indices": [1]})
        src_1 = T.decl_buffer((1,), data=src)
