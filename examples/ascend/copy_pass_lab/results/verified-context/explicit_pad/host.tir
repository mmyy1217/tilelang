# from tvm.script import ir as I
# from tvm.script import tirx as T

@I.ir_module
class Module:
    @T.prim_func
    def main(self_handle: T.handle, args: T.handle, num_args: T.int32, result: T.handle("void", "global")) -> T.int32:
        T.func_attr({"calling_conv": 1, "global_symbol": "__tvm_ffi_main", "target": T.target({"keys": ["cpu"], "kind": "c", "tag": ""}), "thread_extent": {}, "tirx.is_entry_func": True, "tl.has_tma": T.bool(False), "tl.readonly_param_indices": [0, 1]})
        assert num_args == 2, ("RuntimeError", ["main: num_args should be 2"])
        assert not T.isnullptr(args), ("RuntimeError", ["main: args pointer is NULL"])
        src_handle_type_index: T.int32 = T.tvm_struct_get(args, 0, 13, "int32")
        assert src_handle_type_index == 0 or src_handle_type_index == 4 or src_handle_type_index == 7 or 64 <= src_handle_type_index, ("RuntimeError", ["kernel main input src expected pointer or tensor handle"])
        dst_handle_type_index: T.int32 = T.tvm_struct_get(args, 1, 13, "int32")
        assert dst_handle_type_index == 0 or dst_handle_type_index == 4 or dst_handle_type_index == 7 or 64 <= dst_handle_type_index, ("RuntimeError", ["kernel main input dst expected pointer or tensor handle"])
        src_handle: T.handle = T.Select(src_handle_type_index == 70, T.handle_add_byte_offset(T.tvm_struct_get(args, 0, 15, "handle"), 24), T.tvm_struct_get(args, 0, 15, "handle"))
        dst_handle: T.handle = T.Select(dst_handle_type_index == 70, T.handle_add_byte_offset(T.tvm_struct_get(args, 1, 15, "handle"), 24), T.tvm_struct_get(args, 1, 15, "handle"))
        main_src_is_null: T.bool = T.isnullptr(src_handle)
        assert not main_src_is_null, ("RuntimeError", ["main.src is expected to have non-NULL pointer"])
        main_dst_is_null: T.bool = T.isnullptr(dst_handle)
        assert not main_dst_is_null, ("RuntimeError", ["main.dst is expected to have non-NULL pointer"])
        main_src_shape: T.handle("int64", "global") = T.tvm_struct_get(src_handle, 0, 2, "handle")
        main_src_shape_1 = T.decl_buffer((2,), "int64", data=main_src_shape)
        main_dst_shape: T.handle("int64", "global") = T.tvm_struct_get(dst_handle, 0, 2, "handle")
        main_dst_shape_1 = T.decl_buffer((2,), "int64", data=main_dst_shape)
        assert T.tvm_struct_get(src_handle, 0, 4, "int32") == 2, ("RuntimeError", ["kernel main input src ndim mismatch, expected 2"])
        main_src_strides: T.handle("int64", "global") = T.tvm_struct_get(src_handle, 0, 3, "handle")
        main_src_strides_1 = T.decl_buffer((2,), "int64", data=main_src_strides)
        dev_id: T.int32 = T.tvm_struct_get(src_handle, 0, 9, "int32")
        src: T.handle("float32", "global") = T.tvm_struct_get(src_handle, 0, 1, "handle")
        T.attr(src, "storage_alignment", 64)
        assert T.tvm_struct_get(dst_handle, 0, 4, "int32") == 2, ("RuntimeError", ["kernel main input dst ndim mismatch, expected 2"])
        main_dst_strides: T.handle("int64", "global") = T.tvm_struct_get(dst_handle, 0, 3, "handle")
        main_dst_strides_1 = T.decl_buffer((2,), "int64", data=main_dst_strides)
        dst: T.handle("float32", "global") = T.tvm_struct_get(dst_handle, 0, 1, "handle")
        T.attr(dst, "storage_alignment", 64)
        T.attr("default", "device_id", dev_id)
        T.attr("default", "device_type", 12)
        assert T.tvm_struct_get(src_handle, 0, 5, "uint8") == T.uint8(2) and T.tvm_struct_get(src_handle, 0, 6, "uint8") == T.uint8(32) and T.tvm_struct_get(src_handle, 0, 7, "uint16") == T.uint16(1), ("RuntimeError", ["kernel main input src dtype mismatch, expected float32"])
        assert T.Cast("int32", main_src_shape_1[0]) == 4, ("RuntimeError", ["kernel main input src shape[0] violates packed ABI constraint"])
        assert T.Cast("int32", main_src_shape_1[1]) == 30, ("RuntimeError", ["kernel main input src shape[1] violates packed ABI constraint"])
        assert T.if_then_else(T.isnullptr(main_src_strides), 1, T.Cast("int32", main_src_strides_1[1])) == 1, ("RuntimeError", ["kernel main input src strides[1] violates packed ABI constraint"])
        assert T.if_then_else(T.isnullptr(main_src_strides), 1, T.Cast("int32", main_src_strides_1[0])) == 30, ("RuntimeError", ["kernel main input src strides[0] violates packed ABI constraint"])
        assert T.uint64(0) == T.tvm_struct_get(src_handle, 0, 8, "uint64"), ("RuntimeError", ["kernel main input src byte_offset violates packed ABI constraint"])
        assert T.tvm_struct_get(src_handle, 0, 10, "int32") == 12, ("RuntimeError", ["kernel main input src device_type mismatch, expected ext_dev"])
        assert not T.isnullptr(src), ("RuntimeError", ["kernel main input src data pointer is NULL"])
        assert T.tvm_struct_get(dst_handle, 0, 5, "uint8") == T.uint8(2) and T.tvm_struct_get(dst_handle, 0, 6, "uint8") == T.uint8(32) and T.tvm_struct_get(dst_handle, 0, 7, "uint16") == T.uint16(1), ("RuntimeError", ["kernel main input dst dtype mismatch, expected float32"])
        assert T.Cast("int32", main_dst_shape_1[0]) == 4, ("RuntimeError", ["kernel main input dst shape[0] violates packed ABI constraint"])
        assert T.Cast("int32", main_dst_shape_1[1]) == 32, ("RuntimeError", ["kernel main input dst shape[1] violates packed ABI constraint"])
        assert T.if_then_else(T.isnullptr(main_dst_strides), 1, T.Cast("int32", main_dst_strides_1[1])) == 1, ("RuntimeError", ["kernel main input dst strides[1] violates packed ABI constraint"])
        assert T.if_then_else(T.isnullptr(main_dst_strides), 1, T.Cast("int32", main_dst_strides_1[0])) == 32, ("RuntimeError", ["kernel main input dst strides[0] violates packed ABI constraint"])
        assert T.uint64(0) == T.tvm_struct_get(dst_handle, 0, 8, "uint64"), ("RuntimeError", ["kernel main input dst byte_offset violates packed ABI constraint"])
        assert T.tvm_struct_get(dst_handle, 0, 9, "int32") == T.tvm_struct_get(src_handle, 0, 9, "int32"), ("RuntimeError", ["kernel main input dst device_id violates packed ABI constraint"])
        assert T.tvm_struct_get(dst_handle, 0, 10, "int32") == 12, ("RuntimeError", ["kernel main input dst device_type mismatch, expected ext_dev"])
        assert not T.isnullptr(dst), ("RuntimeError", ["kernel main input dst data pointer is NULL"])
        src_1 = T.decl_buffer((4, 30), data=src, strides=(30, 1))
        dst_1 = T.decl_buffer((4, 32), data=dst, strides=(32, 1))
        T.call_packed("__tvm_set_device", 12, dev_id)
        with T.attr(0, "compute_scope", "main_compute_"):
            T.call_packed("main_kernel", dst, src, 1, 512)
        return 0
