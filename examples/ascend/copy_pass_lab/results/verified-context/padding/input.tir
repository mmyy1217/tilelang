# from tvm.script import tirx as T

@T.prim_func
def main(src_handle: T.handle, dst_handle: T.handle):
    src = T.match_buffer(src_handle, (4, 30), strides=(30, 1))
    dst = T.match_buffer(dst_handle, (4, 32), strides=(32, 1))
    # with T.sblock("root"):
    for bx in T.thread_binding(1, thread="blockIdx.x"):
        tx: T.int32 = T.launch_thread_idx(0)
        ty: T.int32 = T.launch_thread_idx(1)
        tz: T.int32 = T.launch_thread_idx(2)
        with T.sblock("tilelang_root"):
            T.reads()
            T.writes()
            ub = T.sblock_alloc_buffer((4, 32), scope="shared.dyn")
            T.ascend_set_copy_pad_value(T.float32(-1.0))
            T.ascend_copy(T.region(src[0, 0], 1, 4, 30), T.region(ub[0, 0], 2, 4, 30), data_select=1)
            T.ascend_copy(T.region(ub[0, 0], 1, 4, 32), T.region(dst[0, 0], 2, 4, 32))
