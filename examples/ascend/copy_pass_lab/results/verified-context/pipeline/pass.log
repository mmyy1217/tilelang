            for step in T.serial(4, annotations={"num_stages": 2}):
                T.ascend_copy(T.region(src[step, 0], 1, 1, 256), T.region(ub_1[0], 2, 256))
                T.ascend_copy(T.region(ub_1[0], 1, 256), T.region(dst[step, 0], 2, 1, 256))

