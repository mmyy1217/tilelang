# from tvm.script import tirx as T

@T.prim_func
def main(src_handle: T.handle, dst_handle: T.handle):
    src = T.match_buffer(src_handle, (128, 64), strides=(64, 1))
    dst = T.match_buffer(dst_handle, (128, 64), strides=(64, 1))
    # with T.sblock("root"):
    for bx in T.thread_binding(1, thread="blockIdx.x"):
        tx: T.int32 = T.launch_thread_idx(0)
        ty: T.int32 = T.launch_thread_idx(1)
        tz: T.int32 = T.launch_thread_idx(2)
        with T.sblock("tilelang_root"):
            T.reads()
            T.writes()
            ub = T.sblock_alloc_buffer((64, 64), scope="shared.dyn")
            T.ascend_copy(T.region(src[0, 0], 1, 128, 64), T.region(ub[0, 0], 2, 64, 64), dual_dst_ctl=1, l2_cache_ctrl=0)
            T.ascend_copy(T.region(ub[0, 0], 1, 64, 64), T.region(dst[0, 0], 2, 128, 64), dual_dst_ctl=1, double=T.bool(True), l2_cache_ctrl=0)
