# from tvm.script import tirx as T

@T.prim_func
def main(src_handle: T.handle):
    src = T.match_buffer(src_handle, (64, 64), "bfloat16", strides=(64, 1))
    # with T.sblock("root"):
    for bx in T.thread_binding(1, thread="blockIdx.x"):
        tx: T.int32 = T.launch_thread_idx(0)
        ty: T.int32 = T.launch_thread_idx(1)
        tz: T.int32 = T.launch_thread_idx(2)
        with T.sblock("tilelang_root"):
            T.reads()
            T.writes()
            l1 = T.handle("bfloat16", "shared.l1")
            l0 = T.handle("bfloat16", "shared.l0a")
            T.sblock_attr({"layout_map": {l1: metadata["tl.AscendFractalLayout"][0], l0: metadata["tl.AscendFractalLayout"][1]}})
            l1_1 = T.sblock_alloc_buffer((64, 64), "bfloat16", data=l1, scope="shared.l1")
            l0_1 = T.sblock_alloc_buffer((32, 32), "bfloat16", data=l0, scope="shared.l0a")
            T.ascend_copy(T.region(src[0, 0], 1, 64, 64), T.region(l1_1[0, 0], 2, 64, 64))
            T.ascend_copy(T.region(l1_1[0, 0], 1, 32, 32), T.region(l0_1[0, 0], 2, 32, 32))
