# from tvm.script import tirx as T

@T.prim_func
def main(src_handle: T.handle):
    src = T.match_buffer(src_handle, (32, 16), "bfloat16", strides=(16, 1))
    # with T.sblock("root"):
    for bx in T.thread_binding(1, thread="blockIdx.x"):
        tx: T.int32 = T.launch_thread_idx(0)
        ty: T.int32 = T.launch_thread_idx(1)
        tz: T.int32 = T.launch_thread_idx(2)
        with T.sblock("tilelang_root"):
            T.reads()
            T.writes()
            l1 = T.handle("bfloat16", "shared.l1")
            T.sblock_attr({"layout_map": {l1: metadata["tl.AscendFractalLayout"][0]}})
            ub = T.sblock_alloc_buffer((32, 16), "bfloat16", scope="shared.dyn")
            l1_1 = T.sblock_alloc_buffer((32, 16), "bfloat16", data=l1, scope="shared.l1")
            T.ascend_copy(T.region(src[0, 0], 1, 32, 16), T.region(ub[0, 0], 2, 32, 16))
            T.ascend_copy(T.region(ub[0, 0], 1, 32, 16), T.region(l1_1[0, 0], 2, 32, 16))
