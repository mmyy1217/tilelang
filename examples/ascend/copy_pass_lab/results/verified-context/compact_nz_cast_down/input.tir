# from tvm.script import tirx as T

@T.prim_func
def main(src_handle: T.handle, dst_handle: T.handle):
    src = T.match_buffer(src_handle, (32, 128), strides=(128, 1))
    dst = T.match_buffer(dst_handle, (33, 128), "bfloat16", strides=(128, 1))
    # with T.sblock("root"):
    for bx in T.thread_binding(1, thread="blockIdx.x"):
        tx: T.int32 = T.launch_thread_idx(0)
        ty: T.int32 = T.launch_thread_idx(1)
        tz: T.int32 = T.launch_thread_idx(2)
        with T.sblock("tilelang_root"):
            T.reads()
            T.writes()
            nz = T.handle("bfloat16", "shared.dyn")
            l1 = T.handle("bfloat16", "shared.l1")
            T.sblock_attr({"layout_map": {nz: metadata["tl.Layout"][0], l1: metadata["tl.AscendFractalLayout"][0]}})
            ub = T.sblock_alloc_buffer((32, 128), scope="shared.dyn")
            nz_1 = T.sblock_alloc_buffer((33, 128), "bfloat16", data=nz, scope="shared.dyn")
            l1_1 = T.sblock_alloc_buffer((32, 128), "bfloat16", data=l1, scope="shared.l1")
            T.ascend_copy(T.region(src[0, 0], 1, 32, 128), T.region(ub[0, 0], 2, 32, 128))
            T.ascend_copy(T.region(ub[0, 0], 1, 32, 128), T.region(nz_1[0, 0], 2, 32, 128))
            T.ascend_copy(T.region(nz_1[0, 0], 1, 33, 128), T.region(dst[0, 0], 2, 33, 128))
